// VM smoke (issue 07): Guided Installer In-Menu Disk Binding — a BOUND OS mirror
// driven through the guided replay. Run with
//   vm.sh --guided --profile single/guided-bound --verify-boot
// Unlike single/guided-multi (which flat-picks Σ disk_count disks + types
// ACCEPT), `guided_bind: true` binds the resolved disks to the OS pool via the
// os_pool_devices replay key, so the bound assignment path (issue 04) runs with
// NO summed flat pick and NO ACCEPT. Reaches INSTALLER-EXIT-0 and the installed
// system boots to ===FIRSTBOOT-OK===. Unencrypted, so it boot-verifies headlessly.
{
  "name": "arch-zfs-test-guided-bound",
  "hardware": { "disks": [40, 40], "ram_mb": 8192, "vcpus": 2 },
  "install": {
    "system": {
      "hostname": "vm-guided-bound",
      "locale":   "en_US.UTF-8",
      "timezone": "Europe/Bucharest",
      "keymap":   "us"
    },
    "options": {
      "kernel":     "lts",
      "bootloader": "systemd-boot",
      "encryption": false,
      "swap":       true,
      "swap_size":  "auto"
    },
    "post_install": {
      "backup": false,
      "security": false,
      "desktop": { "kde": false }
    },
    "guided_layout": "os-mirror",
    "guided_bind": true
  }
}
