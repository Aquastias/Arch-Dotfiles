// VM test (ADR 0062): KDE + Hyprland co-installed on a ZFS-native-encrypted
// single disk. Reproduces the reported install crash where the re-added
// Hyprland extras adapter sourced lib/chroot/gpu.sh — a file the chroot staging
// manifest did not copy — and aborted at [chroot:extras]. The install must now
// run to completion, the encrypted ZFS system must boot (Console Answerer types
// the test passphrase), and BOTH desktops' session-launch artifacts must be
// present: KDE (startplasma-wayland + plasma.desktop) and Hyprland (Hyprland +
// the /usr/local wayland-sessions override the adapter writes). The display
// manager is a separate axis (ADR 0069/0091): with `display_manager` unset it
// resolves to `auto` → sddm (KDE is present; auto is desktop-aware), asserted
// on its own via the DM-OK marker, not folded into the KDE artifact check.
{
  "name": "arch-zfs-test-env-kde-hyprland-enc",
  "hardware": { "disks": [40], "ram_mb": 8192, "vcpus": 2 },
  "install": {
    "system": {
      "hostname": "vm-kde-hyprland-enc",
      "locale":   "en_US.UTF-8",
      "timezone": "UTC",
      "keymap":   "us"
    },
    "options": {
      "kernel":     "lts",
      "bootloader": "systemd-boot",
      "encryption": true,
      "swap":       true,
      "swap_size":  "auto"
    },
    "environment": { "desktop": ["kde", "hyprland"], "gpu": "auto" },
    "post_install": { "backup": false, "security": false },
    "mode":              "single",
    "disk":              "/dev/sda",
    "ashift":            12,
    "os_size":           "32G",
    "os_pool_name":      "rpool",
    "storage_pool_name": "dpool",
    "storage_mount":     "/data",
    "storage_groups":    []
  },
  "verify": { "boot": true, "desktops": ["kde", "hyprland"] }
}
