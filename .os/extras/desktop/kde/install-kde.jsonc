// KDE Plasma package configuration
// Read by extras/desktop/kde/kde.sh when post_install.desktop.kde = true
//
// To add packages after install: sudo pacman -S <package>
{
  // Install KDE Plasma shell + SDDM display manager.
  "shell": true,
  // Install KDE applications (controlled individually below).
  "apps": true,
  // KDE APPLICATIONS as a Categorized List: { category: { pkg: bool } }.
  // Categories are cosmetic (kebab-case); set any package to false to skip
  // it. Parsed in bool mode by the Categorized List Parser at install time.
  //
  // Membership rule, mechanical and verifiable (R21, ADR 0087): a package
  // belongs in `apps_list` IFF its pacman `Groups` contains `kde-applications`.
  // KDE-ecosystem repo apps that lack that group live in `apps_extra` below.
  // The `plasma-included` category is the exception: spectacle,
  // plasma-systemmonitor and discover are `plasma`-group components already
  // pulled by plasma-meta — listed to document intent, a `--needed` no-op.
  "apps_list": {
    "file-management": {
      "ark": true, // Archive manager
      "dolphin": true, // File manager
      "filelight": true // Disk usage visualiser
    },
    "documents": {
      "calligra": true, // Office suite (Words, Sheets, Stage, Karbon)
      "ghostwriter": true, // Distraction-free Markdown editor
      "okular": true // Document viewer (PDF, EPUB, etc.)
    },
    "development": {
      "kate": true // Advanced text editor
    },
    "graphics": {
      "gwenview": true, // Image viewer
      "kcolorchooser": true, // Colour picker
      "kolourpaint": true // Simple paint program
    },
    "multimedia": {
      "elisa": true, // Music player
      "k3b": true, // CD/DVD burner
      "kdenlive": true // Video editor
    },
    "system": {
      "isoimagewriter": true, // Write hybrid ISOs to USB
      "kcalc": true, // Scientific calculator
      "kfind": true, // Find files/folders
      "konsole": true, // Terminal emulator
      "partitionmanager": true, // Partition editor
      "sweeper": true, // Privacy/system cleaner
      "yakuake": true // Drop-down terminal
    },
    "network": {
      "kdeconnect": true, // Phone integration
      "krdc": true, // Remote desktop client (RDP/VNC)
      "krfb": true, // Desktop sharing (VNC server)
      "ktorrent": true // BitTorrent client
    },
    "security": {
      "keysmith": true, // OTP / 2FA client
      "kleopatra": true, // GPG certificate manager
      "kwalletmanager": true // Wallet / secrets manager
    },
    "pim": {
      "merkuro": true // Calendar / contacts / tasks
    },
    "accessibility": {
      "kmag": true // Screen magnifier
    },
    "education": {
      "kiten": true // Japanese reference tool
    },
    "scanning": {
      "skanpage": true // Multi-page document scanner
    },
    "plasma-included": {
      "discover": true, // Software manager (already in plasma-meta)
      "plasma-systemmonitor": true, // System monitor (already in plasma-meta)
      "spectacle": true // Screenshot tool (already in plasma-meta)
    }
  },
  // KDE-ecosystem repo apps whose pacman `Groups` does NOT contain
  // `kde-applications` (ADR 0087). Same Categorized List shape, same install
  // pass, same deselect-in-menu behaviour as `apps_list`; kept separate so
  // `apps_list`'s membership rule stays mechanically checkable.
  "apps_extra": {
    "graphics": {
      "digikam": true, // Photo management
      "krita": true // Digital painting
    },
    "development": {
      "kdiff3": true, // Diff and merge tool
      "kommit": true, // Git GUI client
      "okteta": true // Hex editor
    },
    "file-management": {
      "krename": true, // Batch file renamer
      "krusader": true // Twin-panel file manager
    },
    "multimedia": {
      "haruna": true // mpv-based video player
    }
  },
  // AUR dependencies for this DE, in the adapter's Categorized List shape.
  // Declared here (not installed by this adapter) — the Runner merges them
  // into its single paru pass, so they land only when KDE is selected.
  // `qt6ct-kde` is the Qt6 config tool, DE-tied but not an application.
  "aur": {
    "theming": {
      "qt6ct-kde": true // Qt6 configuration tool, KDE build
    }
  }
}
