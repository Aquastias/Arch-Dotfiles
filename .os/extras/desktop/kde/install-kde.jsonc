// KDE Plasma package configuration
// Read by extras/desktop/kde/kde.sh when post_install.desktop.kde = true
//
// To add packages after install: sudo pacman -S <package>
{
  // Install KDE Plasma shell + SDDM display manager.
  "shell": true,
  // Install KDE applications (controlled individually in apps_list below).
  "apps": true,
  // KDE APPLICATIONS as a Categorized List: { category: { pkg: bool } }.
  // Categories are cosmetic (kebab-case); set any package to false to skip
  // it. Parsed in bool mode by the Categorized List Parser at install time.
  //
  // Membership rule, mechanical and verifiable: a package belongs here IFF its
  // pacman `Groups` contains `kde-applications` (R21). `plasma` and `kf5`
  // groups belong to the shell section in kde.sh; anything else is not KDE and
  // belongs in a host profile. The former `plasma-extras` category held three
  // non-applications and is gone: `sddm-kcm` is a KCM (moved to the shell
  // section, since it is not in plasma-meta), `xdg-desktop-portal-kde` is
  // already in plasma-meta's dependency tree, and `kimageformats5` is the KF5
  // build of a package Plasma 6 gets as `kimageformats` via kscreen — it was
  // installing a stale Qt5 parallel stack for nothing.
  "apps_list": {
    "file-management": {
      "ark": true, // Archive manager
      "dolphin": true, // File manager
      "filelight": true, // Disk usage visualiser
      "krename": true, // Batch file renamer
      "krusader": true // Twin-panel file manager
    },
    "documents": {
      "calligra": true, // Office suite (Writer, Sheets, Stage)
      "okular": true // Document viewer (PDF, EPUB, etc.)
    },
    "graphics": {
      "gwenview": true, // Image viewer
      "krita": true, // Digital painting
      "skanlite": true, // Simple scanner
      "skanpage": true // Multi-page scanner
    },
    "development": {
      "kate": true, // Advanced text editor
      "kdiff3": true, // Diff and merge tool
      "kompare": true, // Diff viewer
      "keditbookmarks": true // Bookmark editor
    },
    "security": {
      "kleopatra": true, // GPG certificate manager
      "kwalletmanager": true // Wallet/secrets manager
    },
    "system": {
      "konsole": true, // Terminal emulator
      "partitionmanager": true // Partition editor
    },
    "network": {
      "ktorrent": true // BitTorrent client
    }
  },
  // AUR dependencies for this DE, in the adapter's Categorized List shape.
  // Declared here (not installed by this adapter) — the Runner merges them
  // into its single paru pass, so they land only when KDE is selected.
  //
  // `octopi` left: a third-party Qt pacman frontend is not KDE, and selecting
  // KDE should not install one. It moved to Host Core's packages.aur beside
  // `pacmanlogviewer` (R21). `qt6ct-kde` arrives from the host profiles — it
  // is the Qt6 config tool, DE-tied but not an application, so it belongs to
  // the adapter rather than to a host that may never select KDE (R10).
  "aur": {
    "theming": {
      "qt6ct-kde": true // Qt6 configuration tool, KDE build
    }
  }
}
