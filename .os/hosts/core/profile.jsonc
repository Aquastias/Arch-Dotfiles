// Host Core profile — the base layer every host profile.jsonc is resolved
// over (ADR 0036, ADR 0056). Declares the shared software base: users, System
// Programs, Sysctl Defaults, AND the Host Package List both real machines
// share.
//
// Carrying packages here amends ADR 0007, whose "the lists are
// machine-specific" premise no longer holds: `laptop` is a strict subset of
// `desktop` (57 repo packages in both, zero unique to laptop), so the shared
// base is real. `hosts/laptop` consequently carries no packages block at all.
//
// The three VM fixtures opt out with `packages.inherit: false` (packages
// only — they still inherit these users and sysctl), so core is free to hold
// the full workstation userland without bloating a test install.
//
// Resolution is per-key (ADR 0057): packages/host_programs/users/sysctl are
// additive, ordered selections (kernel, locale, desktop) are replaced. A host
// drops something core declares via `packages.exclude` /
// `host_programs_exclude`.
//
// `cups` is deliberately NOT declared here (ADR 0079): the print daemon is a
// toggle-derived System Program, driven by `options.printing.enabled` (default
// on) and injected into host_programs at Effective-Config assembly, so it has
// exactly one home — the Guided Installer's Printing service category.
//
// Fonts are likewise NOT declared here (ADR 0080): they moved to the curated
// `options.fonts` Font Catalog, whose default-checked set is the shared
// baseline. Absent `options.fonts` resolves to those defaults, so a font has
// one home — the Guided Installer's General category. ttf-ms-fonts left the AUR
// list for the same reason (the catalog routes it to the paru pass).
{
  "users": [],
  "host_programs": [],
  "sysctl": {
    "vm.swappiness": 10
  },
  "packages": {
    "repo": {
      "system": [
        "fwupd",
        "logrotate",
        "lsb-release",
        "pacmanlogviewer",
        "reflector",
        "sbctl",
        "smartmontools",
        "sof-firmware"
      ],
      "filesystems": [
        "exfatprogs",
        "f2fs-tools",
        "lvm2"
      ],
      "network": [
        "iwd",
        "network-manager-applet",
        "openbsd-netcat",
        "wget"
      ],
      "shell": [
        "bc",
        "btop",
        "eza",
        "fd",
        "fzf",
        "htop",
        "inxi",
        "kitty",
        "lazygit",
        "lynx",
        "nano",
        "parallel",
        "yazi",
        "zoxide"
      ],
      "editors": [
        "neovide",
        "neovim"
      ],
      "dev": [
        "ccache",
        "nvm"
      ],
      "language-servers": [
        "bash-language-server",
        "clang",
        "gopls",
        "rust-analyzer",
        "typescript-language-server",
        "yaml-language-server",
        "zls"
      ],
      "browsers": [
        "firefox"
      ],
      "media": [
        "gimp",
        "imagemagick",
        "pavucontrol",
        "speech-dispatcher",
        "vlc"
      ],
      "gaming": [
        "gamemode",
        "lib32-gamemode",
        "steam"
      ],
      "archive": [
        "7zip",
        "arj",
        "lhasa",
        "unace",
        "unarj",
        "unrar",
        "unzip",
        "zip"
      ]
    },
    "aur": {
      "misc": [
        "ani-cli-git",
        "octopi",
        "vscodium-bin",
        "vscodium-marketplace",
        "zen-browser-bin"
      ],
      "language-servers": [
        "vscode-langservers-extracted"
      ]
    }
  }
}
