// Host Profile for `laptop` (chronos) — the unified, self-contained profile
// (ADR 0036). Merged under hosts/core/profile.jsonc. One file carries the
// hostname, core machine defaults, users, and packages, declares the
// kde desktop, and a single-disk skeleton (one operator-picked
// disk → ESP + rpool + dpool).
//
// Encrypted, SSH-enabled ZFS (persistent root — impermanence disabled).
{
  "system": {
    "hostname": "chronos",
    "locale": "en_US.UTF-8",
    "timezone": "UTC",
    "keymap": "us"
  },
  "filesystem": "zfs",
  "options": {
    "kernel": "lts",
    "bootloader": "systemd-boot",
    "encryption": true,
    "swap": true,
    "swap_size": "auto",
    "ssh": {
      "enabled": true
    }
  },
  "environment": {
    "desktop": [
      "kde"
    ],
    "gpu": "auto"
  },
  "users": [
    "aquastias"
  ],
  "system_programs": [],
  "packages": {
    "repo": {
      "system": [
        "fwupd",
        "lsb-release",
        "reflector",
        "sbctl",
        "smartmontools",
        "sof-firmware",
        "stow",
        "uwsm",
        "zram-generator"
      ],
      "filesystems": [
        "btrfs-progs",
        "lvm2"
      ],
      "network": [
        "iwd",
        "network-manager-applet",
        "nftables",
        "wget",
        "wireless_tools"
      ],
      "shell": [
        "bc",
        "btop",
        "eza",
        "htop",
        "inxi",
        "kitty",
        "less",
        "lynx",
        "nano",
        "parallel",
        "yazi",
        "zoxide"
      ],
      "editors": [
        "neovide"
      ],
      "dev": [
        "ccache",
        "docker",
        "docker-compose",
        "nvm"
      ],
      "browsers": [
        "firefox"
      ],
      "media": [
        "flatpak",
        "gimp",
        "gst-plugin-pipewire",
        "pipewire-jack",
        "speech-dispatcher",
        "vlc"
      ],
      "communication": [
        "discord"
      ],
      "gaming": [
        "gamemode",
        "lib32-gamemode",
        "steam"
      ],
      "virt": [
        "virt-manager"
      ],
      "archive": [
        "7zip",
        "arj",
        "cpio",
        "lhasa",
        "unace",
        "unarj",
        "unrar",
        "unzip"
      ],
      "fonts": [
        "noto-fonts-cjk",
        "noto-fonts-extra",
        "ttf-fira-code",
        "ttf-sazanami"
      ]
    },
    "aur": {
      "misc": [
        "ani-cli-git",
        "btop-theme-catppuccin",
        "papirus-folders-catppuccin-git",
        "qt6ct-kde",
        "ttf-ms-fonts",
        "vscodium-bin",
        "vscodium-marketplace",
        "zen-browser-bin",
        "zinit"
      ]
    }
  },
  "mode": "single",
  "ashift": 12
}
