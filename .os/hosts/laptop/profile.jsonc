// Host Profile for `laptop` (chronos) — the unified, self-contained profile
// (ADR 0036). Resolved over hosts/core/profile.jsonc. One file carries the
// hostname, core machine defaults, and users, declares the kde+hyprland
// desktop, and a single-disk skeleton (one operator-picked disk → ESP + rpool
// + dpool).
//
// **No packages block.** laptop is a strict subset of desktop — 57 repo
// packages in both, zero unique to laptop — so everything it wants is in Host
// Core (ADR 0056). That is the confirmation two layers fit this fleet. To drop
// something core declares, add `packages.exclude`; to add something, declare
// the category here and it concatenates.
//
// Encrypted, SSH-enabled ZFS (persistent root — impermanence disabled).
{
  "system": {
    "hostname": "chronos",
    "locale": "en_US.UTF-8",
    "timezone": "UTC",
    "keymap": "us"
  },
  "filesystem": "zfs",
  "options": {
    "kernel": "lts",
    "bootloader": "systemd-boot",
    "encryption": true,
    "swap": true,
    "swap_size": "auto",
    "ssh": {
      "enabled": true
    }
  },
  "environment": {
    "desktop": [
      "kde",
      "hyprland"
    ],
    "gpu": "auto",
    // Pin SDDM over the kde+hyprland auto→greetd default (ADR 0067): the seatd
    // DRM-master fix (ADR 0068) lets an SDDM-launched Hyprland session take
    // master, so the graphical greeter serves both sessions.
    "display_manager": "sddm"
  },
  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },
  "users": [
    "aquastias"
  ],
  "host_programs": [],
  "mode": "single",
  "ashift": 12
}
