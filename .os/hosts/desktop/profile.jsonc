// Host Profile for `desktop` (eterniox) — the unified, self-contained
// profile (ADR 0036). Merged under hosts/core/profile.jsonc.
//
// Encrypted, impermanent, SSH-enabled ZFS. Persists /home + /var/lib/docker
// + /var/lib/libvirt over the impermanence base set.
//
// One file carries the hostname, core machine defaults, users,
// host_programs, and packages, and declares the full pool skeleton —
// devices excluded, picked at install:
//   os_pool  rpool  mirror (2x NVMe, ashift 12)
//   dpool    raidz1 (3x SSD, ashift 12) -> /data, 1-disk fault tolerant
{
  "system": {
    "hostname": "eterniox",
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "filesystem": "zfs",

  "options": {
    "kernel":       "lts",
    "bootloader":   "systemd-boot",
    "encryption":   true,
    "swap":         true,
    "swap_size":    "auto",
    "impermanence": { "enabled": true },
    "ssh":          { "enabled": true }
  },

  "environment": {
    "desktop": ["kde", "hyprland"],
    "gpu":     "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  "users": ["aquastias"],
  "host_programs": ["grub", "gamemode"],

  "packages": {
    "repo": {
      "system": [
        "stress",
        "stress-ng",
        "tectonic"
      ],
      "filesystems": [
        "bcachefs-tools",
        "fatresize",
        "jfsutils",
        "nilfs-utils",
        "udftools"
      ],
      "network": [
        "dnsmasq"
      ],
      "dev": [
        "biome",
        "go",
        "mermaid-cli",
        "python-pip",
        "python-pipx",
        "tree-sitter-cli"
      ],
      "media": [
        "qbittorrent",
        "vlc-plugin-freetype",
        "vlc-plugin-notify",
        "vlc-plugin-srt"
      ],
      "gaming": [
        "lact",
        "lutris",
        "wine",
        "wine-gecko",
        "wine-mono"
      ],
      "virt": [
        "libguestfs",
        "qemu-full",
        "virt-viewer"
      ]
    },
    "aur": {
      "misc": [
        "bolt-launcher",
        "brave-bin",
        "bridge-utils",
        "ckb-next-git",
        "grayjay-bin",
        "lua-format",
        "runelite"
      ]
    }
  },

  "mode": "multi",
  "os_pool": {
    "pool_name":  "rpool",
    "topology":   "mirror",
    "ashift":     12,
    "disk_count": 2
  },
  "storage_groups": [
    {
      "name":       "data",
      "topology":   "raidz1",
      "ashift":     12,
      "mount":      "/data",
      "disk_count": 3
    }
  ],
  "data_pools": [],

  "persist": {
    "directories": ["/home", "/var/lib/docker", "/var/lib/libvirt"]
  }
}
