// Host Profile for vm/arch-secure — headless VM smoke-test host exercising
// the combined secure path: SOPS (age_key_url) + impermanence + ZFS native
// encryption on a fixed 2-disk OS mirror (ADR 0036; mirrors the inlined
// INSTALL_CONFIG_CONTENT of .os/vm/vm-secure.sh so it is also installable on
// real hardware via the picker). Merged under hosts/core/profile.jsonc.
// Self-contained: core machine defaults + the secure overrides + the
// device-free mirror skeleton (disks operator-picked at install).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": true,
    "swap":       true,
    "swap_size":  "auto",

    "impermanence": {
      "enabled": true,
      "dataset": "rpool/persist",
      "mount":   "/persist"
    },

    "age_key_url": "http://192.168.122.1:9876/key.age",

    // Opt out of the Font Catalog (ADR 0080) — a smoke install wants no fonts,
    // and skips the ttf-ms-fonts AUR build. [] is the explicit "no fonts".
    "fonts": []
  },

  "environment": {
    "desktop": [],
    "gpu":     "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  // Opt out of Host Core's Host Package List (ADR 0056). A test install
  // wants the installer's own base, not the workstation userland — and
  // `inherit: false` is scoped to packages, so this fixture still inherits
  // core's users and sysctl. Cheaper than an exclude list that would need
  // updating every time Host Core grows.
  "packages": { "inherit": false },
  "users": ["vm-test"],
  "host_programs": [],
  // Core-Owned base Programs (ADR 0089) are inherited additively — host_programs
  // has no `inherit: false` — so exclude them to keep this fixture lean.
  "host_programs_exclude": ["ccache"],

  "mode": "multi",
  "os_pool": {
    "pool_name":  "rpool",
    "topology":   "mirror",
    "ashift":     12,
    "disk_count": 2
  },
  "storage_groups": [],
  "data_pools": []
}
