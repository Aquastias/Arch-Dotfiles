// Host Profile for vm/arch-data — VM smoke-test host for the multi
// data-pools ownership check (pool-owners, ADR 0031). First host migrated to
// the unified profile.jsonc (ADR 0036, migration tracer).
//
// Merged under hosts/core/profile.jsonc. Declares one user (vm-data — a
// secrets-free user, so secrets_load is a no-op) to own the /data pools, and
// the full pool skeleton: one OS pool (single-disk, topology none) plus two
// standalone data pools (tank0 stripe, tank1 mirror). Devices are excluded —
// the operator/harness picks disks at install time and the picker maps them
// onto these groups. owners are omitted, so each /data pool defaults to the
// Primary User (vm-data).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto",

    // Opt out of the Font Catalog (ADR 0080) — a smoke install wants no fonts,
    // and skips the ttf-ms-fonts AUR build. [] is the explicit "no fonts".
    "fonts": []
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  // Opt out of Host Core's Host Package List (ADR 0056). A test install
  // wants the installer's own base, not the workstation userland — and
  // `inherit: false` is scoped to packages, so this fixture still inherits
  // core's users and sysctl. Cheaper than an exclude list that would need
  // updating every time Host Core grows.
  "packages": { "inherit": false },
  "users": ["vm-data"],
  // Core-Owned base Programs (ADR 0089) are inherited additively — host_programs
  // has no `inherit: false` — so exclude them to keep this fixture lean.
  "host_programs_exclude": ["ccache"],

  "mode": "multi",
  "os_pool": {
    "pool_name":  "rpool",
    "topology":   "none",
    "ashift":     12,
    "disk_count": 1
  },
  "storage_groups": [],
  "data_pools": [
    { "name": "tank0", "topology": "stripe", "disk_count": 1 },
    { "name": "tank1", "topology": "mirror", "disk_count": 2 }
  ]
}
