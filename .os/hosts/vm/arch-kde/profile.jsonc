// Host Profile for vm/arch-kde — KDE Plasma VM smoke-test host (ADR 0036).
// Merged under hosts/core/profile.jsonc. Self-contained: core machine
// defaults + KDE environment + the single-disk skeleton (one operator-picked
// disk auto-partitioned into ESP + rpool + dpool; no os_pool block needed).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto",

    // Opt out of the Font Catalog (ADR 0080) — a smoke install wants no fonts,
    // and skips the ttf-ms-fonts AUR build. [] is the explicit "no fonts".
    // (KDE's plasma-meta still pulls noto-fonts transitively.)
    "fonts": []
  },

  "environment": {
    "desktop": "kde",
    "gpu":     "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  // Opt out of Host Core's Host Package List (ADR 0056). A test install
  // wants the installer's own base, not the workstation userland — and
  // `inherit: false` is scoped to packages, so this fixture still inherits
  // core's users and sysctl. Cheaper than an exclude list that would need
  // updating every time Host Core grows.
  "packages": { "inherit": false },
  "users": ["aquastias"],
  "host_programs": [],
  // Core-Owned base Programs (ADR 0089) inherit additively — host_programs
  // has no `inherit: false` — so exclude them to keep this fixture lean.
  "host_programs_exclude": ["ccache", "fwupd", "lact", "reflector",
    "smartmontools"],

  "mode":   "single",
  "ashift": 13
}
