// Persistent VM: single-disk Hyprland + Noctalia (shared shell, ADR 0097).
// References host arch-hyprland, so the VM exercises the real Hyprland adapter
// + the SAME Noctalia work preset niri runs (desktop=hyprland,
// wayland_shell=noctalia) — one source of truth. Greeter is greetd/tuigreet
// (auto DM for KDE-free Wayland, ADR 0091); log in and Hyprland autostarts
// Noctalia. The desktop-verify prober waits for the Hyprland compositor + a
// wayland socket (===HYPR-SESSION-OK===).
{
  "name": "arch-hyprland",
  "hardware": { "disks": [60], "ram_mb": 8192, "vcpus": 4 },
  "host_profile": "arch-hyprland",
  "layout": { "mode": "single" }
}
