#!/usr/bin/env bash
# =============================================================================
# vm/fixtures/desktop-verify/desktop-verify — (TEST-ONLY) desktop login prober
# =============================================================================
# Installed by the VM harness (a profile's verify.sessions) as a root systemd
# oneshot at graphical.target. It proves the operator can actually LOG IN to each
# Wayland session, not just that the packages are present:
#
#   Per boot it autologs (via SDDM Autologin, configured by the harness) into ONE
#   session, waits for that session's compositor to actually come up — a wayland
#   socket in the login user's runtime dir AND the expected compositor process —
#   and echoes ===<TAG>-SESSION-OK=== (or -FAIL) to the serial console the host
#   watches. Then it advances: rewrite SDDM Autologin to the next session +
#   reboot, or — after the last — emit ===SESSION-VERIFY-DONE=== and power off.
#
# State (written by the harness) lives in /usr/local/lib/desktop-verify — on the
# ROOT dataset, NOT /var (which the ZFS single-disk layout puts on its own
# dataset; state under /var would be hidden when that dataset mounts at boot):
#   order  — space-separated SDDM session files, e.g. "plasma.desktop hyprland.desktop"
#   tags   — space-separated marker tags,        e.g. "KDE HYPR"
#   user   — the autologin user name
#   idx    — the current session index (starts at 0)
#
# NEVER shipped to a real install — the VM harness copies it onto the test guest.
# =============================================================================
set +e

# Paths are overridable only so tests/vm/desktop-verify.bats can drive it.
S="${DESKTOP_VERIFY_STATE:-/usr/local/lib/desktop-verify}"
TTY="${DESKTOP_VERIFY_TTY:-/dev/ttyS0}"
CONF="${DESKTOP_VERIFY_CONF:-/etc/sddm.conf.d/zz-desktop-verify.conf}"
RUNDIR="${DESKTOP_VERIFY_RUNDIR:-/run/user}"
POLL_SECONDS="${DESKTOP_VERIFY_POLL_SECONDS:-180}"
POLKIT_SECONDS="${DESKTOP_VERIFY_POLKIT_SECONDS:-60}"

read -r -a SESSIONS < "$S/order"
read -r -a TAGS < "$S/tags"
read -r USER_NAME < "$S/user"
IDX=0
[ -f "$S/idx" ] && read -r IDX < "$S/idx"

session="${SESSIONS[$IDX]}"
tag="${TAGS[$IDX]}"
uid="$(id -u "$USER_NAME" 2>/dev/null)"

# Diagnostic to the serial console the harness watches: what state this boot saw.
printf '===SESSION-PROBE idx=%s count=%s session=%s user=%s uid=%s===\n' \
  "$IDX" "${#SESSIONS[@]}" "$session" "$USER_NAME" "$uid" >> "$TTY"

# The compositor process each session must spawn — strong "it really started"
# evidence beyond a bare wayland socket. Matched on the SDDM session file name.
case "$session" in
  plasma*)   proc=kwin_wayland ;;
  hyprland*) proc=Hyprland ;;
  niri*)     proc=niri ;;
  *)         proc="" ;;
esac

ok=0
i=0
while [ "$i" -lt "$POLL_SECONDS" ]; do
  if [ -n "$uid" ] && ls "${RUNDIR}/${uid}"/wayland-* >/dev/null 2>&1; then
    if [ -z "$proc" ] || pgrep -x "$proc" >/dev/null 2>&1; then
      ok=1
      break
    fi
  fi
  i=$((i + 1))
  sleep 1
done

# probe_polkit — which polkit agents serve this session. polkitd 127 does not
# log registrations, so Noctalia's agent is read from its own log ("polkit
# authentication agent active", VM-observed) while noctalia runs; any other
# known agent process is listed too. Two names = two racing agents (ADR 0100
# wants exactly one).
POLKIT_AGENTS="polkit-kde-authentication-agent-1
polkit-gnome-authentication-agent-1 hyprpolkitagent lxqt-policykit-agent
polkit-mate-authentication-agent-1"
probe_polkit() {
  local home log agents="" a j=0
  home="${DESKTOP_VERIFY_HOMEDIR:-$(getent passwd "$USER_NAME" | cut -d: -f6)}"
  log="$home/.cache/noctalia/noctalia.log"
  while [ "$j" -lt "$POLKIT_SECONDS" ]; do
    if pgrep -u "$uid" -f noctalia >/dev/null 2>&1 \
      && grep -q 'polkit authentication agent active' "$log" 2>/dev/null; then
      agents=noctalia
      break
    fi
    j=$((j + 1))
    sleep 1
  done
  for a in $POLKIT_AGENTS; do
    pgrep -x "$a" >/dev/null 2>&1 && agents="${agents}${agents:+,}${a}"
  done
  if [ -n "$agents" ]; then
    printf '===%s-POLKIT-OK agents=%s===\n' "$tag" "$agents" >> "$TTY"
  else
    printf '===%s-POLKIT-FAIL===\n' "$tag" >> "$TTY"
    polkit_diag
  fi
}

# polkit_diag — on FAIL, say why: the seeded setting, polkitd's own log, and
# what Noctalia logged about its agent.
polkit_diag() {
  local home; home="$(getent passwd "$USER_NAME" | cut -d: -f6)"
  {
    printf 'POLKIT-DIAG cfg: %s\n' "$(grep -h 'polkit_agent' \
      "$home/.config/noctalia/config.toml" 2>/dev/null || echo none)"
    journalctl -b -u polkit --no-pager -o cat 2>/dev/null | tail -5 \
      | sed 's/^/POLKIT-DIAG polkitd: /'
    grep -ih 'polkit\|auth.*agent' "$home/.cache/noctalia/noctalia.log" \
      2>/dev/null | tail -8 | sed 's/^/POLKIT-DIAG noctalia: /'
  } >> "$TTY"
}

# probe_idle — Noctalia owns idle in-process (ext-idle-notify), so "active" is
# the shell running for the user with the seeded idle lock enabled.
probe_idle() {
  local home cfg
  home="${DESKTOP_VERIFY_HOMEDIR:-$(getent passwd "$USER_NAME" | cut -d: -f6)}"
  cfg="$home/.config/noctalia/config.toml"
  if pgrep -u "$uid" -f noctalia >/dev/null 2>&1 \
    && sed -n '/^\[idle\.behavior\.lock\]/,/^\[/p' "$cfg" 2>/dev/null \
      | grep -q '^enabled = true'; then
    printf '===%s-IDLE-OK===\n' "$tag" >> "$TTY"
  else
    printf '===%s-IDLE-FAIL===\n' "$tag" >> "$TTY"
  fi
}

if [ "$ok" = 1 ]; then
  printf '===%s-SESSION-OK===\n' "$tag" >> "$TTY"
  case "$tag" in
  NIRI | HYPR) probe_polkit; probe_idle ;;
  esac
else
  printf '===%s-SESSION-FAIL===\n' "$tag" >> "$TTY"
fi

next=$((IDX + 1))
if [ "$next" -lt "${#SESSIONS[@]}" ]; then
  printf '%s\n' "$next" > "$S/idx"
  sed -i "s|^Session=.*|Session=${SESSIONS[$next]}|" "$CONF"
  printf '===SESSION-SWITCH-%s===\n' "${TAGS[$next]}" >> "$TTY"
  sync
  sleep 2
  systemctl reboot
else
  printf '===SESSION-VERIFY-DONE===\n' >> "$TTY"
  sync
  sleep 2
  systemctl poweroff
fi
