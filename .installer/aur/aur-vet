#!/usr/bin/env bash
# =============================================================================
# aur-vet — AUR Vetting (ADR 0143, on the fly since ADR 0149)
# =============================================================================
# Pre-build review of AUR package bases. Text-only (awk/grep): the PKGBUILD
# is never sourced or run, so the review can't execute attacker code.
#
#   aur-vet                    hook: paru PreBuildCommand contract (cwd = the
#                              AUR clone, $PKGBASE set; non-zero aborts)
#   aur-vet export [--check] [repo-aur-dir]
#                              merge the booted allowlist into the repo
#   aur-vet doctor             warn when a paru.conf drops the hook
#   aur-vet audit              scan installed foreign packages (VMs only)
#   aur-vet refresh-indicators pull community Indicator lists for review
#
# Exit: 0 pass · 1 abort (findings or policy) · 2 usage/environment error.
# SELF-CONTAINED: installed onto PATH and staged into the chroot, so it
# sources no Installer/Shell Stdlib — only its own modules (aur-vet-*.sh),
# which ship beside scan.awk. Stateless: each build is decided from the
# clone as it is (ADR 0149); only the allowlist is stored.
# =============================================================================
set -euo pipefail

SELF_DIRECTORY="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Overrides (data, store, RPC fixtures, clock, sudo, …) exist for tests and
# the operator's repo copy (scan.awk beside it). The installed vetter drops
# them, so an environment user-level malware controls can't redirect its
# store, data, RPC answers or sudo (ADR 0143). AUR_VET_UNATTENDED stays: it
# can only refuse prompts, never skip review.
if [[ ! -f "$SELF_DIRECTORY/scan.awk" ]]; then
  unset AUR_VET_DATA AUR_VET_STORE AUR_VET_RPC_FIXTURE_DIR AUR_VET_NOW \
    AUR_VET_SUDO AUR_VET_INTERACTIVE AUR_VET_RETRY_DELAYS AUR_VET_AUDIT_ROOT \
    AUR_VET_ARCH_LIST_URL AUR_VET_NPM_LIST_URL AUR_VET_ETC_PARU_CONF
fi

say() { printf 'aur-vet: %s\n' "$*" >&2; }
die() { say "$*"; exit 2; }

# Data (rules/indicators) and the allowlist sit beside the script in the repo;
# the installed copy reads the system locations.
data_directory() {
  if [[ -n "${AUR_VET_DATA:-}" ]]; then printf '%s' "$AUR_VET_DATA"
  elif [[ -f "$SELF_DIRECTORY/rules.tsv" ]]; then printf '%s' "$SELF_DIRECTORY"
  else printf '%s' /usr/local/share/aur-vet; fi
}

# The engine (scan.awk and the modules) ships with the command, not with the
# data: beside it in the repo, else in share/aur-vet next to its bin/
# (/usr/local/bin/aur-vet → /usr/local/share/aur-vet).
library_directory() {
  if [[ -f "$SELF_DIRECTORY/scan.awk" ]]; then printf '%s' "$SELF_DIRECTORY"
  else printf '%s' "$(dirname "$SELF_DIRECTORY")/share/aur-vet"; fi
}

# Hook-mode results, filled by evaluate (aur-vet-scan.sh): the critical and
# suspicious rule ids (id → 1), the tally line, and whether the RPC was
# down.
declare -A CRITICAL_RULES=() SUSPICIOUS_RULES=()
TALLY=""
RPC_DOWN=0

for module in scan trust allowlist maintenance; do
  # shellcheck source=/dev/null  # aur-vet-scan.sh … beside scan.awk
  source "$(library_directory)/aur-vet-${module}.sh"
done

# ── Hook mode ───────────────────────────────────────────────────────────────
# Decide one build on the spot (ADR 0149): critical aborts; suspicious rules
# not allowlisted for this package ask n/y/a, or abort unattended.
hook() {
  local directory="$PWD" base="${PKGBASE:-$(basename "$PWD")}"
  [[ "$base" =~ ^$AUR_NAME$ ]] || die "invalid package base: ${base}"
  git -C "$directory" rev-parse -q --verify HEAD >/dev/null 2>&1 \
    || die "${base}: not an AUR git clone: ${directory}"
  local head at
  head="$(git -C "$directory" rev-parse HEAD)"
  at="${base} @${head:0:12}"

  evaluate "$directory" "$base"
  local tally="$TALLY" id
  if ((${#CRITICAL_RULES[@]})); then
    abort_build "$at" "$tally" "critical findings always abort"
    return 1
  fi
  if ((RPC_DOWN)); then
    if unattended; then
      abort_build "$at" "$tally" "AUR RPC unreachable"
      return 1
    fi
    ask "AUR RPC unreachable — continue without trust signals?" \
      || { abort_build "$at" "$tally" "AUR RPC unreachable"; return 1; }
  fi

  local -a unallowed=()
  for id in "${!SUSPICIOUS_RULES[@]}"; do
    allowed "$base" "$id" || unallowed+=("$id")
  done
  if ((${#unallowed[@]} == 0)); then
    say "${at}: PASS (${tally})"
    return 0
  fi
  decide_suspicious "$at" "$tally" "$base" "${unallowed[@]}"
}

# abort_build <at> <tally> <reason> — say why the build of <at> stops.
abort_build() { say "${1}: ABORT (${2}) — $3"; }

# decide_suspicious <at> <tally> <pkgbase> <rule>… — the not-allowlisted
# suspicious rules: abort unattended, else ask n (abort), y (once) or
# a (always: allowlist them for <pkgbase>).
decide_suspicious() {
  local at="$1" tally="$2" base="$3"; shift 3
  local reason="suspicious findings not allowlisted: $*" question id
  local -a rows=()
  if unattended; then
    abort_build "$at" "$tally" "${reason} (answer interactively to accept)"
    return 1
  fi
  say "${at}: ${reason}"
  question="Build ${at}? n = abort, y = once, a = always for ${base}"
  case "$(choose "$question")" in
    y) say "${at}: PASS (${tally}) — accepted once" ;;
    a)
      for id in "$@"; do
        rows+=("$(printf '%s\t%s\treviewed %s' "$base" "$id" "$(today)")")
      done
      allow_add "${rows[@]}"
      say "${at}: PASS (${tally}) — allowlisted for ${base}: $*"
      ;;
    *) abort_build "$at" "$tally" "rejected"; return 1 ;;
  esac
}

# print_help — the header comment from line 5 to the next ==== rule, without
# its leading "# ".
print_help() {
  local line number=0
  while IFS= read -r line; do
    number=$((number + 1))
    ((number >= 5)) || continue
    [[ "$line" == "# ===="* ]] && return 0
    [[ "$line" == "#"* ]] && line="${line:1}"
    [[ "$line" == " "* ]] && line="${line:1}"
    printf '%s\n' "$line"
  done < "${BASH_SOURCE[0]}"
}

case "${1:-}" in
  "") hook ;;
  refresh-indicators) refresh_indicators ;;
  export) shift; export_allowlist "$@" ;;
  audit) audit ;;
  doctor) doctor ;;
  -h | --help) print_help ;;
  *) die "unknown command: $1" ;;
esac
