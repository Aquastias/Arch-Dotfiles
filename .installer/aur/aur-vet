#!/usr/bin/env bash
# =============================================================================
# aur-vet — AUR Vetting (ADR 0143)
# =============================================================================
# Pre-build review of AUR package bases. Text-only (awk/grep): the PKGBUILD
# is never sourced or run, so the review can't execute attacker code.
#
#   aur-vet                    hook: paru PreBuildCommand contract (cwd = the
#                              AUR clone, $PKGBASE set; non-zero aborts)
#   aur-vet seed [--list] [pkg...]
#                              bulk-review declared AUR packages + AUR deps
#   aur-vet export [--check] [repo-aur-dir]
#                              merge the booted pin store into the repo
#   aur-vet audit              scan installed foreign packages (VMs only)
#   aur-vet refresh-indicators pull community Indicator lists for review
#
# Exit: 0 pass · 1 abort (findings or policy) · 2 usage/environment error.
# SELF-CONTAINED: installed onto PATH and staged into the chroot, so it
# sources no Installer/Shell Stdlib (seed alone reads the repo checkout).
# =============================================================================
set -euo pipefail

_SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

# Overrides (data, store, RPC fixtures, clock, sudo, …) exist for tests and
# the operator's repo copy (scan.awk beside it). The installed vetter drops
# them, so an environment user-level malware controls can't redirect its
# store, data, RPC answers or sudo (ADR 0143). AUR_VET_UNATTENDED stays: it
# can only refuse prompts, never skip review.
if [[ ! -f "$_SELF_DIR/scan.awk" ]]; then
  unset AUR_VET_DATA AUR_VET_STORE AUR_VET_RPC_FIXTURE_DIR AUR_VET_NOW \
    AUR_VET_SUDO AUR_VET_INTERACTIVE AUR_VET_RETRY_DELAYS AUR_VET_GIT_BASE \
    AUR_VET_REPO AUR_VET_AUDIT_ROOT AUR_VET_ARCH_LIST_URL AUR_VET_NPM_LIST_URL
fi

_say() { printf 'aur-vet: %s\n' "$*" >&2; }
_die() { _say "$*"; exit 2; }

# Data (rules/indicators) and the pin store sit beside the script in the repo;
# the installed copy reads the system locations.
_data_dir() {
  if [[ -n "${AUR_VET_DATA:-}" ]]; then printf '%s' "$AUR_VET_DATA"
  elif [[ -f "$_SELF_DIR/rules.tsv" ]]; then printf '%s' "$_SELF_DIR"
  else printf '%s' /usr/local/share/aur-vet; fi
}

# The engine (scan.awk) ships with the command, not with the data.
_lib_dir() {
  if [[ -f "$_SELF_DIR/scan.awk" ]]; then printf '%s' "$_SELF_DIR"
  else printf '%s' /usr/local/share/aur-vet; fi
}

# Findings for the clone at <dir> <pkgbase> on stdout: TSV from scan.awk
# (severity id file line description).
_scan() {
  local dir="$1" base="$2" data day bins=""; data="$(_data_dir)"
  local -a files=()
  local f
  for f in rules indicators campaigns; do
    [[ -r "$data/$f.tsv" ]] || _die "missing data file: $data/$f.tsv"
  done
  while IFS= read -r -d '' f; do
    [[ -s "$dir/$f" ]] || continue
    # Text files are scanned; the rest are reported by name, never skipped.
    if LC_ALL=C grep -Iq . "$dir/$f" 2>/dev/null; then files+=("$dir/$f")
    else bins+="${f}"$'\037'; fi
  done < <(git -C "$dir" ls-files -z)
  day="$(TZ=UTC git -C "$dir" log -1 --format=%cd --date=format-local:%F)"
  awk -v root="$dir" -v pkgbase="$base" -v commit_day="$day" \
    -v rules="$data/rules.tsv" -v indicators="$data/indicators.tsv" \
    -v campaigns="$data/campaigns.tsv" -v binaries="$bins" \
    -f "$(_lib_dir)/scan.awk" "${files[@]+"${files[@]}"}" </dev/null
}


# ── refresh-indicators ──────────────────────────────────────────────────────
# Pull the official Arch Atomic Arch list and lenucksi's npm list, append the
# names not yet held, tagged with their source key, and print them for review.
# Explicit and offline-safe: vetting itself never fetches (ADR 0143).
_ARCH_LIST_URL="https://md.archlinux.org/s/SxbqukK6IA/download"
_NPM_LIST_URL="https://raw.githubusercontent.com/lenucksi/aur-malware-check"
_NPM_LIST_URL+="/main/data/campaigns/aur-infected/npm-packages.txt"

_refresh_indicators() {
  local ind; ind="$(_data_dir)/indicators.tsv"
  [[ -w "$ind" ]] || _die "not writable: $ind"
  local arch npm add
  arch="$(curl -fsSL "${AUR_VET_ARCH_LIST_URL:-$_ARCH_LIST_URL}")" \
    || _die "download failed: Arch package list"
  npm="$(curl -fsSL "${AUR_VET_NPM_LIST_URL:-$_NPM_LIST_URL}")" \
    || _die "download failed: npm package list"
  # AUR names are [a-z0-9@._+-]; anything else (markup, typos) is dropped.
  add="$(
    {
      printf '%s\n' "$arch" | awk '/^[a-z0-9@._+-]+$/ {
        printf "pkgbase\t%s\tatomic-arch\tarch-md\n", $1 }'
      printf '%s\n' "$npm" | awk '/^[a-z0-9@._\/-]+$/ {
        printf "npm\t%s\tatomic-arch\tlenucksi\n", $1 }'
    } | awk -F'\t' 'FNR == NR { if (!/^#/) seen[$1 FS $2]; next }
                    !(($1 FS $2) in seen) { seen[$1 FS $2]; print }' "$ind" -
  )"
  local count=0
  if [[ -n "$add" ]]; then
    printf '%s\n' "$add" >> "$ind"
    count="$(printf '%s\n' "$add" | wc -l)"
    printf '%s\n' "$add"
  fi
  _say "added ${count} indicator(s) to ${ind} — review the diff, then commit"
}

# ── Pin store (Vetted Commits) ──────────────────────────────────────────────
# vetted.tsv: pkgbase commit maintainer date note — one row per package.
# allow.tsv:  pkgbase commit rule note — suspicious findings accepted for
# exactly that commit (ADR 0143).
_store_dir() {
  if [[ -n "${AUR_VET_STORE:-}" ]]; then printf '%s' "$AUR_VET_STORE"
  elif [[ -f "$_SELF_DIR/vetted.tsv" ]]; then printf '%s' "$_SELF_DIR"
  else printf '%s' /etc/aur-vet; fi
}

# Unattended never prompts. The installer says so explicitly; otherwise a
# terminal on stdin means a human is there. AUR_VET_INTERACTIVE forces the
# prompt (tests) — it can only ask for more review, never skip it.
_unattended() {
  [[ "${AUR_VET_UNATTENDED:-}" == 1 ]] && return 0
  [[ "${AUR_VET_INTERACTIVE:-}" == 1 ]] && return 1
  [[ ! -t 0 ]]
}

_today() { date -u -d "@${AUR_VET_NOW:-$(date +%s)}" +%F; }

# Print "<commit>\t<maintainer>" of <pkgbase>'s Vetted Commit, if any.
_pin_of() {
  local f; f="$(_store_dir)/vetted.tsv"
  [[ -r "$f" ]] || return 0
  awk -F'\t' -v b="$1" '$1 == b { r = $2 "\t" $3 } END { if (r) print r }' "$f"
}

_allowed() {
  local f; f="$(_store_dir)/allow.tsv"
  [[ -r "$f" ]] || return 1
  awk -F'\t' -v b="$1" -v c="$2" -v r="$3" \
    '$1 == b && $2 == c && $3 == r { hit = 1 } END { exit !hit }' "$f"
}

# Replace <file>'s content with stdin. A writable store (repo, tests) is
# rewritten in place via a temp file in its own dir, so a failed write leaves
# the old file intact. The booted store is root-owned, so user-level malware
# can't forge pins (ADR 0143): writes go through sudo — non-interactive when
# unattended, where the installer's temporary NOPASSWD grant carries them.
_store_put() {
  local file="$1" tmp
  if [[ -w "$(dirname "$file")" ]]; then
    tmp="$(mktemp "${file}.XXXXXX")"
    cat > "$tmp"
    chmod 0644 "$tmp"
    command mv -f "$tmp" "$file"
    return 0
  fi
  local sudo="${AUR_VET_SUDO:-sudo}"
  local -a flags=()
  _unattended && flags=(-n)
  tmp="$(mktemp)"
  cat > "$tmp"
  if ! command -v "$sudo" >/dev/null 2>&1 \
     || ! "$sudo" "${flags[@]}" install -m0644 "$tmp" "$file"; then
    command rm -f "$tmp"
    _die "pin store not writable: ${file} (needs sudo)"
  fi
  command rm -f "$tmp"
}

# Record <pkgbase> <commit> <maintainer> <note>; <old> carries its allowlist
# rows to the new commit (bump-only: the flagged lines did not change).
_set_pin() {
  local base="$1" commit="$2" maint="$3" note="$4" carry="${5:-}"
  local store; store="$(_store_dir)"
  local vf="$store/vetted.tsv" af="$store/allow.tsv"
  [[ -e "$vf" ]] || : > "$vf" 2>/dev/null || true
  {
    awk -F'\t' -v b="$base" '$1 != b' "$vf" 2>/dev/null || true
    printf '%s\t%s\t%s\t%s\t%s\n' "$base" "$commit" "$maint" "$(_today)" \
      "$note"
  } | _store_put "$vf"
  if [[ -n "$carry" && -r "$af" ]]; then
    awk -F'\t' -v OFS='\t' -v b="$base" -v o="$carry" -v n="$commit" \
      '{ print } $1 == b && $2 == o { $2 = n; print }' "$af" | _store_put "$af"
  fi
}

_allow_add() {
  local af; af="$(_store_dir)/allow.tsv"
  { cat "$af" 2>/dev/null || true; printf '%s\n' "$@"; } | _store_put "$af"
}

# ── Diff classification ─────────────────────────────────────────────────────
# Bump-only: only PKGBUILD/.SRCINFO changed, each line a version bump
# (bump-only.awk).
_bump_only() {
  local dir="$1" old="$2" new="$3" n
  while IFS= read -r n; do
    [[ "$n" == PKGBUILD || "$n" == .SRCINFO ]] || return 1
  done < <(git -C "$dir" diff --name-only "$old" "$new")
  git -C "$dir" diff -U0 "$old" "$new" -- PKGBUILD .SRCINFO \
    | awk -f "$(_lib_dir)/bump-only.awk"
}

# ── Review output ───────────────────────────────────────────────────────────
_review_full() {
  local dir="$1" f
  while IFS= read -r -d '' f; do
    if ! LC_ALL=C grep -Iq . "$dir/$f" 2>/dev/null; then
      printf '==> %s (binary, %s bytes) <==\n' "$f" "$(wc -c < "$dir/$f")"
      continue
    fi
    printf '==> %s <==\n' "$f"
    cat -n "$dir/$f"
  done < <(git -C "$dir" ls-files -z) >&2
}

_review_diff() {
  git -C "$1" --no-pager diff --stat "$2" "$3" >&2
  git -C "$1" --no-pager diff "$2" "$3" >&2
}

_ask() {
  local ans
  printf 'aur-vet: %s [y/N] ' "$1" >&2
  read -r ans || return 1
  [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]]
}
# ── Trust signals (AUR RPC) ─────────────────────────────────────────────────
_RPC_URL="https://aur.archlinux.org/rpc/v5/info"
_TRUST_WINDOW=$((14 * 86400))

# One RPC `info` answer for <pkgbase> (queried by <pkgname>), valid JSON or
# failure. Tests serve <pkgbase>.json from AUR_VET_RPC_FIXTURE_DIR instead.
_rpc_fetch() {
  local out
  if [[ -n "${AUR_VET_RPC_FIXTURE_DIR:-}" ]]; then
    out="$(cat "$AUR_VET_RPC_FIXTURE_DIR/$1.json" 2>/dev/null)" || return 1
  else
    out="$(curl -fsS --max-time 20 "${_RPC_URL}?arg%5B%5D=${2//+/%2B}")" \
      || return 1
  fi
  jq -e '.results | type == "array"' >/dev/null 2>&1 <<<"$out" || return 1
  printf '%s\n' "$out"
}

# Run <cmd...> with the RPC retry policy (ADR 0052 pattern):
# AUR_VET_RETRY_DELAYS is the CSV of per-gap seconds. Prints the output of
# the first success; non-zero when every attempt failed.
_rpc_retry() {
  local -a delays
  IFS=, read -ra delays <<<"${AUR_VET_RETRY_DELAYS:-3,10}"
  local tries=$((${#delays[@]} + 1)) i out
  for ((i = 1; i <= tries; i++)); do
    if out="$("$@")"; then printf '%s\n' "$out"; return 0; fi
    _say "RPC attempt ${i}/${tries} failed"
    ((i < tries)) && sleep "${delays[i - 1]:-0}"
  done
  return 1
}

_rpc_info() { _rpc_retry _rpc_fetch "$@"; }

# Trust findings (scan TSV shape, file "AUR") for <dir> <pkgbase> against
# the pin's <maintainer> (<pinned> 1|0), plus a `meta maintainer` row with
# the AUR's current one. Returns 3 when the RPC is unreachable.
_trust() {
  local dir="$1" base="$2" pmaint="$3" pinned="$4"
  local name json r
  name="$(awk -F' = ' '/^pkgname = / { print $2; exit }' \
    "$dir/.SRCINFO" 2>/dev/null)"
  json="$(_rpc_info "$base" "${name:-$base}")" || return 3
  local -A sev=() desc=()
  local id s d
  while IFS=$'\t' read -r id s d; do sev[$id]="$s"; desc[$id]="$d"
  done < <(awk -v rules="$(_data_dir)/rules.tsv" -v list_trust=1 \
             -f "$(_lib_dir)/scan.awk" </dev/null)
  _t() { [[ -n "${sev[$1]:-}" ]] && printf '%s\tAUR\t0\t%s%s\n' \
    "${sev[$1]}"$'\t'"$1" "${desc[$1]}" "${2:+ [$2]}"; return 0; }

  r="$(jq -c --arg b "$base" \
    '[.results[] | select(.PackageBase == $b)][0] // empty' <<<"$json")"
  if [[ -z "$r" ]]; then _t trust-not-found; return 0; fi
  local maint sub first last ood votes now
  IFS=$'\x1f' read -r maint sub first last ood votes < <(jq -r '[
    .Maintainer // "", .Submitter // "", .FirstSubmitted // 0,
    .LastModified // 0, .OutOfDate // "", .NumVotes // 0]
    | map(tostring) | join("\u001f")' <<<"$r")
  printf 'meta\tmaintainer\tAUR\t0\t%s\n' "$maint"
  now="${AUR_VET_NOW:-$(date +%s)}"
  if ((pinned)) && [[ -z "$pmaint" && -n "$maint" ]]; then
    _t trust-maintainer-unrecorded "now ${maint}"
  fi
  if ((pinned)) && [[ -n "$pmaint" && "$maint" != "$pmaint" ]]; then
    _t trust-maintainer-changed "${pmaint} -> ${maint:-orphan}"
  fi
  if ((!pinned)) && [[ -n "$maint" && -n "$sub" && "$maint" != "$sub" ]] \
     && ((now - last < _TRUST_WINDOW)); then
    _t trust-adopted "${sub} -> ${maint}"
  fi
  ((now - first < _TRUST_WINDOW)) && _t trust-new
  [[ -z "$maint" ]] && _t trust-orphaned
  [[ -n "$ood" ]] && _t trust-out-of-date
  ((votes < 3)) && _t trust-low-votes "${votes}"
  return 0
}

# ── seed ────────────────────────────────────────────────────────────────────
# One-time bulk review: every AUR package the repo declares plus its AUR
# dependencies, each through the hook's interactive review, pinned on
# accept. Operator-side (needs the repo checkout); resumable — bases that
# already have a pin are skipped.
_seed_repo() { printf '%s' "${AUR_VET_REPO:-$_SELF_DIR/..}"; }

# Every AUR name the repo declares, one per line (repeats allowed): host
# packages.aur, DE adapter `aur` lists, AUR fonts, and each name after
# `${AUR_HELPER} -S` in a User Program (its repo names drop out at the RPC).
_declared_aur() {
  local repo f; repo="$(_seed_repo)"
  [[ -d "$repo/hosts" ]] \
    || _die "seed: no installer repo at ${repo} — pass package names"
  # shellcheck source=../lib/jsonc.sh
  source "$repo/lib/jsonc.sh"
  # Categorized List leaves: string arrays (hosts) or { name: true } toggles
  # (adapters); a false toggle is off.
  local leaves='def leaves: if type == "array" then .[] | strings
    elif type == "object" then to_entries[]
      | if .value == true then .key else (.value | leaves) end
    else empty end; leaves'
  for f in "$repo"/hosts/*/profile.jsonc "$repo"/hosts/*/*/profile.jsonc; do
    [[ -f "$f" ]] || continue
    jsonc_strip "$f" | jq -r ".packages.aur // {} | $leaves"
  done
  for f in "$repo"/extras/desktop/*/install-*.jsonc; do
    [[ -f "$f" ]] && jsonc_strip "$f" | jq -r ".aur // {} | $leaves"
  done
  sed -n 's/^[[:space:]]*"\([^|"]*\)|aur|[a-z]*"$/\1/p' \
    "$repo/lib/config/fonts.sh" 2>/dev/null || true
  for f in "$repo"/programs/*/*/install.sh; do
    [[ -f "$f" ]] || continue
    awk '
      /\\$/ { held = held substr($0, 1, length($0) - 1) " "; next }
      { l = held $0; held = "" }
      l ~ /[$][{]?AUR_HELPER[}]?/ {
        sub(/.*[$][{]?AUR_HELPER[}]?/, "", l); sub(/[;&|#].*/, "", l)
        n = split(l, t, /[[:space:]]+/)
        for (i = 1; i <= n; i++)
          if (t[i] ~ /^[a-z0-9@_+][a-z0-9@._+-]*$/) print t[i]
      }' "$f"
  done
}

# RPC `info` results for <names...> as {"results": [...]}, 100 per request
# with retries. Fixture mode serves <name>.json per queried name.
_rpc_query() {
  if [[ -n "${AUR_VET_RPC_FIXTURE_DIR:-}" ]]; then
    local n
    for n; do cat "$AUR_VET_RPC_FIXTURE_DIR/$n.json" 2>/dev/null || true; done \
      | jq -s '{ results: [.[].results[]] }'
    return
  fi
  local -a all=("$@") chunk
  local i q parts=""
  for ((i = 0; i < ${#all[@]}; i += 100)); do
    chunk=("${all[@]:i:100}")
    q="$(printf 'arg%%5B%%5D=%s&' "${chunk[@]//+/%2B}")"
    parts+="$(_rpc_retry curl -fsS --max-time 30 "${_RPC_URL}?${q%&}")" \
      || return 1
    parts+=$'\n'
  done
  jq -s '{ results: [.[].results[]] }' <<<"$parts"
}

# Package bases for <names...> plus their AUR depends/makedepends/
# checkdepends, recursively, in discovery order. Names the AUR doesn't know
# (repo packages) drop out; so do virtual deps only an AUR provider supplies
# — the paru hook still vets those at install time.
_seed_resolve() {
  local -A seen_name=() seen_base=()
  local -a queue=() next=()
  local n b deps json
  for n; do
    [[ -n "${seen_name[$n]:-}" ]] && continue
    seen_name[$n]=1; queue+=("$n")
  done
  while ((${#queue[@]})); do
    json="$(_rpc_query "${queue[@]}")" || _die "seed: AUR RPC unreachable"
    next=()
    while IFS=$'\t' read -r b deps; do
      [[ -n "$b" && -z "${seen_base[$b]:-}" ]] \
        && { seen_base[$b]=1; printf '%s\n' "$b"; }
      for n in $deps; do
        n="${n%%[<>=]*}"
        [[ -n "${seen_name[$n]:-}" ]] && continue
        seen_name[$n]=1; next+=("$n")
      done
    done < <(jq -r '.results[] | [.PackageBase, ((.Depends // [])
      + (.MakeDepends // []) + (.CheckDepends // []) | join(" "))] | @tsv' \
      <<<"$json")
    queue=("${next[@]+"${next[@]}"}")
  done
}

_seed() {
  local list=0
  [[ "${1:-}" == --list ]] && { list=1; shift; }
  local -a names=() bases=()
  if (($#)); then names=("$@")
  else mapfile -t names < <(_declared_aur | sort -u); fi
  ((${#names[@]})) || { _say "seed: nothing declared"; return 0; }
  mapfile -t bases < <(_seed_resolve "${names[@]}")
  if ((list)); then
    ((${#bases[@]} == 0)) || printf '%s\n' "${bases[@]}"
    return 0
  fi
  local work b ok=0 skipped=0
  local -a rejected=()
  work="$(mktemp -d)"
  # shellcheck disable=SC2064  # expand now: $work is local
  trap "rm -rf '$work'" EXIT
  for b in "${bases[@]}"; do
    if [[ -n "$(_pin_of "$b")" ]]; then skipped=$((skipped + 1)); continue; fi
    if ! git clone -q "${AUR_VET_GIT_BASE:-https://aur.archlinux.org}/$b.git" \
         "$work/$b"; then
      rejected+=("${b}(clone failed)"); continue
    fi
    if (cd "$work/$b" && PKGBASE="$b" _hook); then ok=$((ok + 1))
    else rejected+=("$b"); fi
  done
  _say "seed: pinned ${ok}, skipped ${skipped} (already pinned)"
  if ((${#rejected[@]})); then
    _say "seed: rejected: ${rejected[*]}"
    return 1
  fi
}

# ── export ──────────────────────────────────────────────────────────────────
# Merge the booted store back into the repo pin files (default: the dotfiles
# checkout) for the operator to commit: a store row replaces the repo row of
# the same pkgbase, new ones append, repo comments stay; allowlist rows
# union. `--check` only reports drift (exit 1).
_export() {
  local check=0
  [[ "${1:-}" == --check ]] && { check=1; shift; }
  local repo="${1:-$HOME/.dotfiles/.installer/aur}"
  local src="${AUR_VET_STORE:-/etc/aur-vet}" f new drift=0
  [[ -f "$repo/vetted.tsv" ]] || _die "export: no pin file at ${repo}"
  for f in vetted allow; do
    [[ -r "$src/$f.tsv" ]] || continue
    new="$(_export_merge "$f" "$src/$f.tsv" "$repo/$f.tsv")"
    local changes
    changes="$(diff <(cat "$repo/$f.tsv" 2>/dev/null) <(printf '%s\n' "$new") \
      | sed -n 's/^> /+ /p; s/^< /- /p')" || true
    [[ -z "$changes" ]] && continue
    drift=1
    printf '%s.tsv:\n%s\n' "$f" "$changes"
    ((check)) || printf '%s\n' "$new" > "$repo/$f.tsv"
  done
  if ((check)); then
    ((drift)) && { _say "export: drift between ${src} and ${repo}"; return 1; }
    _say "export: ${src} and ${repo} in sync"
    return 0
  fi
  if ((drift)); then
    _say "export: updated ${repo} — review the diff, then commit"
  else
    _say "export: nothing to export"
  fi
}

# <kind> <store-file> <repo-file> → the merged repo file on stdout.
_export_merge() {
  awk -F'\t' -v kind="$1" '
    function key() { return kind == "vetted" ? $1 : $1 FS $2 FS $3 }
    FNR == NR {
      if ($0 ~ /^#/ || !NF) next
      k = key(); if (!(k in s)) order[++n] = k
      s[k] = $0; next
    }
    /^#/ || !NF { print; next }
    { k = key(); if (k in s) { print s[k]; done[k] = 1 } else print }
    END { for (i = 1; i <= n; i++) if (!(order[i] in done)) print s[order[i]] }
  ' "$2" "${3}" 2>/dev/null || cat "$2"
}

# ── audit ───────────────────────────────────────────────────────────────────
# Post-install check for installer-created VMs, never the operator's host
# (ADR 0143): installed foreign packages on a campaign list, campaign npm/bun
# packages in caches or global node_modules, and on-disk IOC paths.
# AUR_VET_AUDIT_ROOT prefixes every path (tests).
_audit() {
  local root="${AUR_VET_AUDIT_ROOT:-}" data kind value camp hits=0
  data="$(_data_dir)"
  local -A pkg=()
  local -a npm=() paths=() homes=()
  while IFS=$'\t' read -r kind value camp; do
    case "$kind" in
      pkgbase) pkg[$value]="$camp" ;;
      npm) npm+=("$value") ;;
      path) paths+=("$value") ;;
    esac
  done < <(awk -v rules="$data/rules.tsv" -v indicators="$data/indicators.tsv" \
             -v campaigns="$data/campaigns.tsv" -v list_indicators=1 \
             -f "$(_lib_dir)/scan.awk" </dev/null)
  _hit() { _say "AUDIT $*"; hits=$((hits + 1)); }

  local p
  while IFS= read -r p; do
    [[ -n "${pkg[$p]:-}" ]] && _hit "installed ${p} is on the ${pkg[$p]} list"
  done < <(pacman -Qmq 2>/dev/null || true)

  local h n
  for h in "$root"/home/* "$root/root"; do
    [[ -d "$h" ]] && homes+=("$h")
  done
  for n in "${npm[@]}"; do
    for h in "${homes[@]}"; do
      grep -rqsF -- "/${n}/-/" "$h/.npm/_cacache/index-v5" \
        && _hit "npm cache of ${h#"$root"} holds ${n}"
      for p in "$h/.bun/install/cache/${n}" "$h/.bun/install/cache/${n}@"* \
               "$h/.local/lib/node_modules/${n}" \
               "$h/.npm-global/lib/node_modules/${n}"; do
        [[ -e "$p" ]] && _hit "${p#"$root"}"
      done
    done
    for p in "$root/usr/lib/node_modules/${n}" \
             "$root/usr/local/lib/node_modules/${n}"; do
      [[ -e "$p" ]] && _hit "${p#"$root"}"
    done
  done
  for p in "${paths[@]}"; do
    # shellcheck disable=SC2088  # a literal ~/ marker from indicators.tsv
    if [[ "$p" == "~/"* ]]; then
      for h in "${homes[@]}"; do
        [[ -e "$h/${p#"~/"}" ]] && _hit "${h#"$root"}/${p#"~/"}"
      done
    elif [[ -e "${root}${p}" ]]; then
      _hit "$p"
    fi
  done

  if ((hits)); then _say "audit: ${hits} finding(s)"; return 1; fi
  _say "audit: clean"
}

# ── Hook mode ───────────────────────────────────────────────────────────────
_hook() {
  local dir="$PWD" base="${PKGBASE:-$(basename "$PWD")}"
  git -C "$dir" rev-parse -q --verify HEAD >/dev/null 2>&1 \
    || _die "${base}: not an AUR git clone: ${dir}"
  local head; head="$(git -C "$dir" rev-parse HEAD)"
  local at="${base} @${head:0:12}"

  # The pin decides both the review mode and the maintainer to compare.
  local pin pcommit="" pmaint=""
  pin="$(_pin_of "$base")"
  [[ -n "$pin" ]] && IFS=$'\t' read -r pcommit pmaint <<<"$pin"

  local -a findings=()
  # Fail closed: an engine error must abort, never read as "no findings".
  local out trust="" rpc_down=0
  out="$(_scan "$dir" "$base")" || _die "${base}: scan failed"
  trust="$(_trust "$dir" "$base" "$pmaint" "$([[ -n "$pcommit" ]] && echo 1 \
    || echo 0)")" || rpc_down=1
  [[ -n "$trust" ]] && out+="${out:+$'\n'}${trust}"
  [[ -n "$out" ]] && mapfile -t findings <<<"$out"

  local row sev id file ln desc crit=0 susp=0 info=0 rpc_maint="$pmaint"
  local -A suspicious=()
  for row in "${findings[@]}"; do
    IFS=$'\t' read -r sev id file ln desc <<<"$row"
    if [[ "$sev" == meta ]]; then rpc_maint="$desc"; continue; fi
    _say "$(printf '%s %s %s:%s %s' "${sev^^}" "$id" "$file" "$ln" "$desc")"
    case "$sev" in
      critical) crit=$((crit + 1)) ;;
      suspicious) susp=$((susp + 1)); suspicious["$id"]=1 ;;
      *) info=$((info + 1)) ;;
    esac
  done
  local tally="${crit} critical, ${susp} suspicious, ${info} info"
  _abort() { _say "${at}: ABORT (${tally}) — $1"; }
  if ((crit)); then _abort "critical findings always abort"; return 1; fi
  if ((rpc_down)); then
    if _unattended; then _abort "AUR RPC unreachable"; return 1; fi
    _ask "AUR RPC unreachable — continue without trust signals?" \
      || { _abort "AUR RPC unreachable"; return 1; }
  fi

  # What the pin says about this commit. Writes are deferred to the verdict.
  local review="" reason="" carry=""
  if [[ -z "$pcommit" ]]; then
    review="full"; reason="unpinned: no Vetted Commit"
  elif [[ "$pcommit" == "$head" ]]; then
    :
  elif ! git -C "$dir" cat-file -e "${pcommit}^{commit}" 2>/dev/null; then
    review="full"; reason="Vetted Commit ${pcommit:0:12} not in history"
  elif _bump_only "$dir" "$pcommit" "$head"; then
    carry="$pcommit"
  else
    review="diff"; reason="changed since Vetted Commit ${pcommit:0:12}"
  fi

  local -a unallowed=()
  for id in "${!suspicious[@]}"; do
    _allowed "$base" "$head" "$id" \
      || { [[ -n "$carry" ]] && _allowed "$base" "$carry" "$id"; } \
      || unallowed+=("$id")
  done
  if [[ -z "$review" ]] && ((${#unallowed[@]})); then
    reason="suspicious findings not allowlisted: ${unallowed[*]}"
  fi

  if [[ -z "$reason" ]]; then
    if [[ -n "$carry" ]]; then
      _set_pin "$base" "$head" "$pmaint" bump-only "$carry"
      _say "${at}: bump-only diff since ${carry:0:12} — auto-accepted"
    fi
    _say "${at}: PASS (${tally})"
    return 0
  fi

  if _unattended; then
    _abort "${reason} (review interactively to accept)"
    return 1
  fi
  _say "${at}: ${reason}"
  case "$review" in
    full) _review_full "$dir" ;;
    diff) _review_diff "$dir" "$pcommit" "$head" ;;
  esac
  if ! _ask "Accept ${at} as the Vetted Commit?"; then
    _abort "rejected"
    return 1
  fi
  _set_pin "$base" "$head" "$rpc_maint" reviewed
  local -a rows=()
  for id in "${unallowed[@]}"; do
    rows+=("$(printf '%s\t%s\t%s\treviewed %s' \
      "$base" "$head" "$id" "$(_today)")")
  done
  ((${#rows[@]} == 0)) || _allow_add "${rows[@]}"
  _say "${at}: PASS (${tally}) — accepted and pinned"
}

case "${1:-}" in
  "") _hook ;;
  refresh-indicators) _refresh_indicators ;;
  seed) shift; _seed "$@" ;;
  export) shift; _export "$@" ;;
  audit) _audit ;;
  -h | --help) sed -n '5,19p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' ;;
  *) _die "unknown command: $1" ;;
esac
