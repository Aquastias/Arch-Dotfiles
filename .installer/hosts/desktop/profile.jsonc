// Host Profile for `desktop` (eterniox) — the unified, self-contained
// profile (ADR 0036). Merged under hosts/core/profile.jsonc.
//
// Encrypted, impermanent, SSH-enabled ZFS. Persists /home + /var/lib/docker
// + /var/lib/libvirt over the impermanence base set.
//
// One file carries the hostname, core machine defaults, users, and the full
// pool skeleton — devices excluded, picked at install:
//   os_pool  rpool  mirror (2x NVMe, ashift 12)
//   dpool    raidz1 (3x SSD, ashift 12) -> /data, 1-disk fault tolerant
//
// **No packages block.** desktop and laptop run the same software, so every app
// lives in Host Core; both machines are core + per-machine hardware/hostname
// (ADR 0114, superseding ADR 0056's laptop-subset framing).
{
  "system": {
    "hostname": "eterniox",
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "filesystem": "zfs",

  "options": {
    "kernel":       "lts",
    "bootloader":   "systemd-boot",
    "encryption":   true,
    "swap":         true,
    "swap_size":    "auto",
    "impermanence": { "enabled": true },
    "ssh":          { "enabled": true }
  },

  "environment": {
    "desktop": ["kde", "hyprland"],
    "gpu":     "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  "users": ["aquastias"],
  "host_programs": [],

  "mode": "multi",
  "os_pool": {
    "pool_name":  "rpool",
    "topology":   "mirror",
    "ashift":     12,
    "disk_count": 2
  },
  "storage_groups": [
    {
      "name":       "data",
      "topology":   "raidz1",
      "ashift":     12,
      "mount":      "/data",
      "disk_count": 3
    }
  ],
  "data_pools": [],

  "persist": {
    "directories": ["/home", "/var/lib/docker", "/var/lib/libvirt"]
  }
}
