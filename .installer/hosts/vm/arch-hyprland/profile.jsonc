// Host Profile for vm/arch-hyprland — Hyprland + Noctalia VM (ADR 0036/0097).
// Merged under hosts/core + the Fleet Layer. A COMPLETE desktop: folds the
// Fleet Layer's full package userland + the shared Noctalia environment on
// Hyprland, on a single-disk skeleton (one operator-picked disk
// auto-partitioned into ESP + rpool + dpool; no os_pool block needed). No
// display_manager → auto resolves to greetd for a KDE-free Wayland session
// (ADR 0091). Same wayland_shell as arch-niri — only the compositor backend
// differs (ADR 0097).
{
  // A fleet host (ADR 0157): folds the Fleet Layer — the operator's software.
  "fleet": true,

  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto"
  },

  "environment": {
    "desktop":       "hyprland",
    "wayland_shell": "noctalia",
    "gpu":           "auto",
    "stock":         false
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  "users": ["aquastias"],
  "host_programs": [],

  "mode":   "single",
  "ashift": 13
}
