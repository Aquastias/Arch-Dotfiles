// Host Profile for vm/arch-niri — niri + Noctalia VM (ADR 0036/0090/0093).
// Merged under hosts/core/profile.jsonc. A COMPLETE desktop: inherits Host
// Core's full package userland + the niri/Noctalia environment, on a
// single-disk skeleton (one operator-picked disk auto-partitioned into ESP +
// rpool + dpool; no os_pool block needed). No display_manager → auto resolves
// to greetd for a KDE-free Wayland session (ADR 0091).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto"
  },

  "environment": {
    "desktop":    "niri",
    "niri_shell": "noctalia",
    "gpu":        "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  "users": ["aquastias"],
  "host_programs": [],

  "mode":   "single",
  "ashift": 13
}
