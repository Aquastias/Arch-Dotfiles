// Host Profile for vm/arch-niri — niri + Noctalia VM smoke-test host
// (ADR 0036/0090/0093). Merged under hosts/core/profile.jsonc. Self-contained:
// core machine defaults + the niri/Noctalia environment + the single-disk
// skeleton (one operator-picked disk auto-partitioned into ESP + rpool + dpool;
// no os_pool block needed). No display_manager → auto resolves to greetd for a
// KDE-free Wayland session (ADR 0091).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto",

    // Opt out of the Font Catalog (ADR 0080) — a smoke install wants no fonts.
    "fonts": []
  },

  "environment": {
    "desktop":    "niri",
    "niri_shell": "noctalia",
    "gpu":        "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  // Opt out of Host Core's Host Package List (ADR 0056) — the smoke wants the
  // installer's base + the niri/Noctalia environment (adapter-driven, so the
  // enriched plugin set still installs), not the full workstation userland.
  "packages": { "inherit": false },
  "users": ["aquastias"],
  "host_programs": [],

  "mode":   "single",
  "ashift": 13
}
