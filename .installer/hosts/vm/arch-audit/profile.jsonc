// Host Profile for vm/arch-audit — the Feature Audit's max-feature base
// (ADR 0152). Every feature one install can hold at once: the three
// compositors + Noctalia, ZFS native encryption on a 2-disk mirror, a data
// storage group, impermanence, SOPS (Test Age Key via age_key_url, host
// secrets.json), every post_install selection, printing, bluetooth and
// power-profiles-daemon (tuned conflicts with the ppd Plasma pulls, so it
// is a variant). Audit Variants patch this to reach the other side
// of each mutually-exclusive choice (bootloader, firewall, power daemon, ...).
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": true,
    "swap":       true,
    "swap_size":  "auto",

    "impermanence": {
      "enabled": true,
      "dataset": "rpool/persist",
      "mount":   "/persist"
    },

    "age_key_url": "http://192.168.122.1:9876/key.age",

    "printing":  { "enabled": true },
    "bluetooth": { "enabled": true },
    "power":     { "profile": "power-profiles-daemon" },
    "ssh":       { "enabled": true },

    // every Font Catalog token (ADR 0080)
    "fonts": [
      "noto-fonts", "noto-fonts-emoji", "noto-fonts-cjk", "noto-fonts-extra",
      "ttf-liberation", "ttf-dejavu", "ttf-ms-fonts",
      "ttf-jetbrains-mono-nerd", "ttf-iosevka-nerd", "ttf-firacode-nerd",
      "otf-monaspace-nerd", "ttf-sazanami"
    ]
  },

  "environment": {
    "desktop":       ["kde", "niri", "hyprland"],
    "wayland_shell": "noctalia",
    "gpu":           "auto"
  },

  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },

  "users": ["aquastias"],
  "host_programs": [],

  "mode": "multi",
  "os_pool": {
    "pool_name":  "rpool",
    "topology":   "mirror",
    "ashift":     12,
    "disk_count": 2
  },
  "storage_groups": [
    {
      "name":       "data",
      "topology":   "stripe",
      "ashift":     12,
      "mount":      "/data",
      "disk_count": 1
    }
  ],
  "data_pools": []
}
