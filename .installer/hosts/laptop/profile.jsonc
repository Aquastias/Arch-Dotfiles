// Host Profile for `laptop` (chronos) — the unified, self-contained profile
// (ADR 0036). Resolved over hosts/core then the Fleet Layer
// (hosts/fleet/profile.jsonc, ADR 0157). One file carries the
// hostname, core machine defaults, and users, declares the kde+niri+hyprland
// desktop, and a single-disk skeleton (one operator-picked disk → ESP + rpool
// + dpool).
//
// **No software packages.** desktop and laptop run the same software, so every
// app lives in the Fleet Layer (ADR 0114, ADR 0157). To drop something it
// declares, add `packages.exclude`; to add something, declare the category
// here and it concatenates.
//
// Encrypted, SSH-enabled ZFS (persistent root — impermanence disabled).
{
  // A fleet host (ADR 0157): folds the Fleet Layer — the operator's software.
  "fleet": true,

  "system": {
    "hostname": "chronos",
    "locale": "en_US.UTF-8",
    "timezone": "UTC",
    "keymap": "us"
  },
  "filesystem": "zfs",
  "options": {
    "kernel": "lts",
    "bootloader": "systemd-boot",
    "encryption": true,
    "swap": true,
    "swap_size": "auto",
    "ssh": {
      "enabled": true
    },
    // 16 GB shared by ARC and games: cap ARC at 4 GiB (ADR 0161).
    "zfs": {
      "arc_max": "4G"
    }
  },
  "environment": {
    // Element 0 is the Default Session a fresh login lands on (ADR 0159).
    "desktop": [
      "umbriel",
      "kde",
      "niri",
      "hyprland"
    ],
    "gpu": "auto"
  },
  "post_install": {
    "security": {
      "firewall":  "firewalld",
      "antivirus": true,
      "rootkit":   true,
      "apparmor":  true
    },
    "backup": { "zfs_auto_snapshot": true, "borg": true }
  },
  "users": [
    "aquastias"
  ],
  "host_programs": [],
  // Legion 5 15ARH7H hardware support (ADR 0161): LenovoLegionLinux — fan
  // curves, CPU temperature, Legion power modes (Arch Wiki: Laptop/Lenovo).
  // Package-only: the module autoloads via its ACPI/WMI ids, and legiond stays
  // off so power-profiles-daemon owns platform_profile.
  "packages": {
    "aur": {
      "hardware": [
        "lenovolegionlinux-dkms-git",
        "lenovolegionlinux-git"
      ]
    }
  },
  "mode": "single",
  "ashift": 12
}
