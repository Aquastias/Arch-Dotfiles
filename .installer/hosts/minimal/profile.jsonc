// Host Profile for `minimal` — the desktop-less base install (archinstall's
// "minimal" role). Merged under hosts/core/profile.jsonc (ADR 0036).
//
// No desktop: `environment.desktop: []` resolves the display manager to `none`,
// so the Environment Runner dispatches no DE adapter (ADR 0005) — a TTY boot.
//
// Bare userland: `packages.inherit: false` opts out of Host Core's workstation
// Host Package List (ADR 0056) — the installer's own base only, nothing else.
// Minimal end-to-end (ADR 0134): the bare `server` user sets
// `programs_inherit: false`, so it also carries none of User Core's workstation
// programs (kitty, yazi, virt-manager, pi, claude, …) — a headless box, not a
// workstation reusing a workstation identity. sysctl is still inherited. The
// operator adds everything post-install, the empty-canvas archinstall promise.
//
// Simplest bootable skeleton: one operator-picked disk, no encryption. Copy and
// edit for encryption / mirror / a desktop.
{
  "system": {
    "locale":   "en_US.UTF-8",
    "timezone": "UTC",
    "keymap":   "us"
  },

  "options": {
    "kernel":     "lts",
    "bootloader": "systemd-boot",
    "encryption": false,
    "swap":       true,
    "swap_size":  "auto"
  },

  "environment": {
    "desktop": [],
    "gpu":     "auto"
  },

  "packages": { "inherit": false },
  "users": ["server"],
  "host_programs": [],

  "mode":   "single",
  "ashift": 12
}
