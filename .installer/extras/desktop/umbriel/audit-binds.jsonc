// Feature Audit keybind expectations for Umbriel (ADR 0152/0159) — one per
// bind the shipped .config/umbriel/conf.d/*.toml declares (a chord match wins
// over an action glob). Effects and fields: lib/feature-audit/binds.sh +
// binds-guest.sh; `needs` tokens as niri's (stack, floating, workspace2,
// ws2win, dir:<d>).
{
  "expect": [
    { "action": "spawn:kitty", "effect": "window-opens", "arg": "kitty" },
    { "action": "spawn:pcmanfm-qt", "effect": "window-opens",
      "arg": "pcmanfm" },
    { "action": "window-close", "effect": "window-closes" },
    { "action": "spawn:noctalia msg panel-toggle launcher",
      "effect": "screen-changes", "recovery": "escape" },
    { "action": "spawn:noctalia msg session lock",
      "effect": "screen-changes", "recovery": "unlock" },
    // Umbriel asks first; Return confirms (src/input/keyboard.cpp)
    { "action": "session-quit", "effect": "session-ends", "then": ["Return"],
      "session_ending": true, "recovery": "session" },
    { "action": "cheatsheet-toggle", "effect": "screen-changes",
      "recovery": "toggle" },

    { "action": "window-toggle-fullscreen", "effect": "layout-changes" },
    { "action": "window-toggle-floating", "effect": "layout-changes" },
    { "action": "window-focus-switch-floating", "effect": "focus-changes",
      "needs": "floating" },

    { "action": "window-focus-left", "effect": "focus-changes",
      "needs": "dir:left" },
    { "action": "window-focus-right", "effect": "focus-changes",
      "needs": "dir:right" },
    { "action": "window-focus-up", "effect": "focus-changes",
      "needs": "stack dir:up" },
    { "action": "window-focus-down", "effect": "focus-changes",
      "needs": "stack dir:down" },
    { "action": "column-move-left", "effect": "layout-changes",
      "needs": "dir:left" },
    { "action": "column-move-right", "effect": "layout-changes",
      "needs": "dir:right" },
    { "action": "window-move-up", "effect": "layout-changes",
      "needs": "stack dir:up" },
    { "action": "window-move-down", "effect": "layout-changes",
      "needs": "stack dir:down" },

    { "action": "workspace-switch:*", "effect": "workspace", "arg": "{num}" },
    // moving to the workspace a column is already on changes nothing
    { "action": "column-move-to-workspace:1", "effect": "layout-changes",
      "needs": "ws2win workspace2" },
    { "action": "column-move-to-workspace:*", "effect": "layout-changes" },
    { "action": "workspace-next", "effect": "workspace-changes" },
    { "action": "workspace-previous", "effect": "workspace-changes",
      "needs": "workspace2" },
    { "action": "column-move-to-workspace-next", "effect": "layout-changes" },
    { "action": "column-move-to-workspace-previous",
      "effect": "layout-changes", "needs": "ws2win workspace2" },
    { "action": "workspace-move-down", "effect": "workspace-changes",
      "needs": "ws2win" },
    { "action": "workspace-move-up", "effect": "workspace-changes",
      "needs": "ws2win workspace2" },

    { "action": "spawn:noctalia msg screenshot-region",
      "effect": "screen-changes", "recovery": "escape" },
    { "action": "spawn:noctalia msg screenshot-fullscreen",
      "effect": "file-created", "arg": "Pictures" },
    { "action": "spawn:grim *", "effect": "file-created", "arg": "Pictures" },

    { "action": "overview-toggle", "effect": "screen-changes",
      "recovery": "toggle" },
    { "action": "window-cycle-primary-extent*", "effect": "layout-changes" },
    { "action": "window-toggle-maximize-to-edges",
      "effect": "layout-changes" },
    { "action": "column-center", "effect": "screen-changes" },
    { "action": "window-modify-primary-extent:*", "effect": "layout-changes" },
    { "action": "window-modify-secondary-extent:*",
      "effect": "layout-changes", "needs": "stack" },
    { "action": "column-toggle-tabbed", "effect": "layout-changes",
      "needs": "stack" },
    { "action": "window-consume-or-expel-left", "effect": "layout-changes" },
    { "action": "window-consume-or-expel-right", "effect": "layout-changes",
      "needs": "dir:right" },
    { "action": "window-consume-from-right", "effect": "layout-changes",
      "needs": "dir:right" },

    { "action": "output-focus-*", "effect": "unverifiable",
      "reason": "one virtual monitor in the VM" },
    { "action": "column-move-to-output-*", "effect": "unverifiable",
      "reason": "one virtual monitor in the VM" },
    { "action": "dpms-off", "effect": "unverifiable",
      "reason": "DPMS state is not observable over grim in a VM" },
    { "action": "shortcuts-inhibit-toggle", "effect": "unverifiable",
      "reason": "no shortcut-inhibiting client in the VM" },

    // Umbriel-only (ADR 0159)
    { "action": "window-toggle-scratchpad", "effect": "layout-changes" },
    { "action": "scratchpad-toggle", "effect": "screen-changes",
      "recovery": "toggle" },
    { "action": "scratchpad-focus-next", "effect": "unverifiable",
      "reason": "needs two scratchpad windows on show; the scene has none" },
    { "action": "column-focus-tab-*", "effect": "unverifiable",
      "reason": "needs a tab group; the scene builds stacks, not tabs" },
    { "action": "window-toggle-pinned", "effect": "layout-changes" },
    { "action": "workspace-set-layout:toggle", "effect": "layout-changes" },

    // raising a volume already at the 1.0 cap changes nothing: lower first
    { "chord": "XF86AudioRaiseVolume", "effect": "audio-changes",
      "pre": ["XF86AudioLowerVolume"] },
    { "action": "spawn:wpctl *", "effect": "audio-changes" },
    { "action": "spawn:brightnessctl *", "effect": "unverifiable",
      "reason": "no backlight device in a VM" },
    { "action": "spawn:playerctl *", "effect": "unverifiable",
      "reason": "no MPRIS player running in the audit session" }
  ]
}
