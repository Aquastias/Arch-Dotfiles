// niri Noctalia work-preset configuration (ADR 0090)
// Read by extras/desktop/niri/niri.sh and the Package Resolver when
// environment.niri_shell = "noctalia". The base preset (noctalia, kitty,
// brightnessctl) is non-negotiable and lives in lib/packages/niri.sh; the
// bools below are the optional companions layered on top. Flip one to add or
// drop it — the menu's only niri control is the niri_shell on/off choice, so
// these component toggles live here (mirroring KDE's install-kde.jsonc).
{
  // Bitwarden vault-search plugin: installs bitwarden-cli and seeds the
  // official Luau plugin into /etc/skel (ADR 0090). Default on — the user
  // authenticates with `bw login` on first use.
  "bitwarden": true,
  // Audio visualizer. Off by default: cava is a known audio sample-rate
  // footgun with Noctalia's visualizer widget.
  "cava": false,
  // Clipboard-history backend. Off by default — Noctalia's clipboard history
  // works without a separate backend for most users.
  "cliphist": false
}
