// niri Noctalia work-preset configuration (ADR 0090/0093)
// Read by extras/desktop/niri/niri.sh and the Package Resolver when
// environment.niri_shell = "noctalia". The base preset (noctalia, kitty,
// brightnessctl) is non-negotiable and lives in lib/packages/niri.sh; the
// bools below are the optional companions + the enriched plugin set layered on
// top. Flip one to add or drop it — the menu's only niri control is the
// niri_shell on/off choice, so these component toggles live here (mirroring
// KDE's install-kde.jsonc). Turning every plugin off recovers the lean shell.
{
  // ── Companions ─────────────────────────────────────────────────────────────
  // Audio visualizer. Off by default: cava is a known audio sample-rate
  // footgun with Noctalia's visualizer widget.
  "cava": false,
  // Clipboard-history backend. Off by default — Noctalia's clipboard history
  // works without a separate backend for most users.
  "cliphist": false,

  // ── Enriched community plugin set (ADR 0093/0094) ──────────────────────────
  // Each key is a community-plugins subdir vendored at a pinned ref; the stowed
  // config.toml carries the matching enabled list (a drift guard keeps the two
  // in step). Its official-repo tool deps install only when on. The
  // overlap-losers (color_picker, screen_recorder, system-monitor,
  // system-updater, config-swap, calculator, keybind-cheatsheet,
  // battery-threshold) are deliberately absent (ADR 0093); bitwarden and
  // mini-docker were dropped from the default set (ADR 0094).
  "keymap": true,
  "niri-active-workspace": true,
  "niri-animations": true,
  "niri-displays": true,
  "sharednd": true,
  "screen-toolkit": true,
  "wl-screen-mirror": true,
  "arch-updater": true,
  "audio-switcher": true,
  "procmon": true,
  "cat": true,
  "gamer-mode": true,
  "drive-health": true,
  "eyecare": true,
  "file-search": true,
  "shell-command": true,
  "ssh-launcher": true,
  "custom-shortcut": true,
  "udiskie": true,
  "todo": true,
  "wallpaper-switcher": true,
  "portctl": true,
  "game-launcher": true,
  "hotspot": true,
  "bookmarks": true,
  "llamanager": true,
  "dns-switcher": true,

  // ── Laptop-gated battery plugins (ADR 0093) ────────────────────────────────
  // `laptop`: "auto" detects a battery (/sys/class/power_supply/BAT*) at
  // install; set true/false to force. When the gate is on, the pair below (each
  // still individually toggleable) is vendored. battery-threshold is
  // deliberately absent (battery-power-management already sets the limit).
  "laptop": "auto",
  "battery-power-management": true,
  "battery-widget": true
}
