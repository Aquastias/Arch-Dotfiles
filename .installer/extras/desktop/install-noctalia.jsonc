// Noctalia work-preset configuration (ADR 0090/0093/0097) — SHARED by the niri
// AND Hyprland adapters, read by both and the Package Resolver when
// environment.wayland_shell = "noctalia". The base preset (noctalia, kitty,
// brightnessctl) is non-negotiable and lives in lib/packages/niri.sh; the bools
// below are the optional companions + the enriched plugin set layered on top.
// Plugins are grouped: a compositor-AGNOSTIC shared core, then per-compositor
// SLICES (niri-* / hypr-*) — each adapter installs shared + its own slice, so
// config.toml stays byte-identical across compositors (ADR 0097). Flip one to
// add or drop it — the menu's only shell control is the wayland_shell on/off
// choice, so these toggles live here (mirroring KDE's install-kde.jsonc).
// Turning every plugin off recovers the lean shell.
{
  // ── Companions ─────────────────────────────────────────────────────────────
  // Audio visualizer. Off by default: cava is a known audio sample-rate
  // footgun with Noctalia's visualizer widget.
  "cava": false,
  // Clipboard-history backend. Off by default — Noctalia's clipboard history
  // works without a separate backend for most users.
  "cliphist": false,

  // ── Shared core plugin set — compositor-agnostic (ADR 0093/0094/0097) ──────
  // Each key is a community-plugins subdir vendored at a pinned ref; the stowed
  // config.toml carries the matching enabled list for THIS core set (a drift
  // guard keeps the two in step). Its official-repo tool deps install only when
  // on. The overlap-losers (color_picker, screen_recorder, system-monitor,
  // system-updater, config-swap, calculator, keybind-cheatsheet,
  // battery-threshold) are deliberately absent (ADR 0093); bitwarden and
  // mini-docker were dropped from the default set (ADR 0094).
  "keymap": true,
  "sharednd": true,
  "screen-toolkit": true,
  "wl-screen-mirror": true,
  "arch-updater": true,
  "audio-switcher": true,
  "procmon": true,
  "cat": true,
  "gamer-mode": true,
  "drive-health": true,
  "eyecare": true,
  "file-search": true,
  "shell-command": true,
  "ssh-launcher": true,
  "custom-shortcut": true,
  "udiskie": true,
  "todo": true,
  "wallpaper-switcher": true,
  "portctl": true,
  "game-launcher": true,
  "hotspot": true,
  "bookmarks": true,
  "llamanager": true,
  "dns-switcher": true,

  // ── niri slice — vendored only on a niri box (ADR 0097) ────────────────────
  // Compositor-specific plugins reading niri's IPC/state. Never written into the
  // shared config.toml; the first-login one-shot enables the vendored set.
  "niri-active-workspace": true,
  "niri-animations": true,
  "niri-displays": true,

  // ── Hyprland slice — vendored only on a Hyprland box (ADR 0097) ─────────────
  // Hyprland-native niceties (not a mirror of the niri slice — workspace/anim/
  // display have no hypr counterpart at the pinned ref). Each id verified present
  // at the ref. hypr-screen-mirror overlaps the core wl-screen-mirror on
  // Hyprland (both installed) — kept by explicit choice.
  "hypr-layout-switcher": true,
  "hypr-submap": true,
  "hypr-screen-mirror": true,

  // ── Laptop-gated battery plugins (ADR 0093) ────────────────────────────────
  // `laptop`: "auto" detects a battery (/sys/class/power_supply/BAT*) at
  // install; set true/false to force. When the gate is on, the pair below (each
  // still individually toggleable) is vendored. battery-threshold is
  // deliberately absent (battery-power-management already sets the limit).
  "laptop": "auto",
  "battery-power-management": true,
  "battery-widget": true
}
