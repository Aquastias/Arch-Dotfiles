// User Profile for vm-test (ADR 0036) — throwaway user for the vm-secure
// smoke test. Merged under users/core/profile.jsonc. No user programs: the
// smoke test exercises the system install path, not user program install.
{
  "shell": "/bin/bash",
  "sudo":  true,
  "groups": [],
  "programs": [],
  // User Core declares docker + virt-manager for every real user; this
  // throwaway excludes both so the smoke test exercises the system install
  // path,
  // not user program installs (ADR 0057).
  "programs_exclude": ["docker", "virt-manager"],
  "ssh_authorized_keys": []
}
