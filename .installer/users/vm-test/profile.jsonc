// User Profile for vm-test (ADR 0036) — throwaway user for the vm-secure
// smoke test. Merged under users/core/profile.jsonc. No user programs: the
// smoke test exercises the system install path, not user program install.
{
  "shell": "/bin/bash",
  "sudo":  true,
  "groups": [],
  "programs": [],
  // User Core declares virt-manager + podman + searxng for every real user;
  // this throwaway excludes them so the smoke test exercises the system install
  // path, not user program installs (ADR 0057).
  "programs_exclude":
    ["zsh", "kitty", "lazygit", "yazi", "virt-manager", "podman", "searxng",
     "pi"],
  "ssh_authorized_keys": []
}
