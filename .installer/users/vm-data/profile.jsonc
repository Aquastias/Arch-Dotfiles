// User Profile for vm-data (ADR 0036) — throwaway user for the multi
// data-pools ownership smoke test (pool-owners, ADR 0031). Merged under
// users/core/profile.jsonc. Ships no secrets.json (secrets_load is a no-op)
// and no programs, to keep the install focused on data-pool ownership.
{
  "shell": "/bin/bash",
  "sudo":  true,
  "groups": [],
  "programs": [],
  // User Core declares docker + virt-manager for every real user; this
  // throwaway excludes both so the install stays focused on data-pool
  // ownership,
  // not user program installs (ADR 0057).
  "programs_exclude": ["docker", "virt-manager"],
  "ssh_authorized_keys": []
}
