// User Core profile — the neutral base layer every user profile.jsonc is
// resolved over (ADR 0036, ADR 0057). Lists concat+dedupe with the user
// profile; scalars user-wins.
//
// Neutral by design (ADR 0157): any user created through the Guided Installer
// inherits this, so it carries no personal tooling — bash, the generic device
// groups, no programs. The operator's userland (zsh, kitty, the coding agents,
// nvim, …) lives on users/aquastias. Root stays /bin/bash (ADR 0054,
// options.root_shell).
{
  "shell": "/bin/bash",
  "sudo": false,
  "groups": ["audio", "video", "storage", "optical", "network", "seat"],
  "programs": [],
  "ssh_authorized_keys": []
}
