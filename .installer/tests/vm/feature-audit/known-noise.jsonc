// Known Noise (ADR 0152): expected log lines that are not Findings.
// Entry: { "regex": ERE | [piece…], "source"?: str, "phase"?: str,
//         "variants"?: [id], "reason": str } (variants: Audit Variant ids,
// absent = all; an array regex is one ERE split across lines, concatenated).
// Every entry needs maintainer approval; reason cites the why or ADR.
[
  // ── installer: upstream build output and expected install paths ──
  { "regex": "\\.cache/paru/clone/.*(warning|error)", "source": "installer",
    "reason": "AUR packages' own compiler/debugedit output while building" },
  { "regex": ["^(Error while writing index for|objcopy: .*\\.gdb_index|",
              "warning: \\.gdb_index)"],
    "source": "installer",
    "reason": "makepkg debug-package indexing of prebuilt AUR binaries" },
  { "regex": "^/usr/(src/debug|include)/.*: warning: ", "source": "installer",
    "reason": "AUR packages' own C/C++ compiler warnings" },
  { "regex": ["^==> WARNING: (Possibly missing firmware|",
              "Using existing \\$srcdir|",
              "Package contains reference to \\$srcdir)"],
    "reason": "mkinitcpio/makepkg advisories (firmware for absent hardware)" },
  { "regex": "^==> WARNING: sd-vconsole: \"/etc/vconsole.conf\" not found",
    "source": "installer",
    "reason": "pacstrap's throwaway first image; configure rebuilds it" },
  { "regex": ["^\\[WARN\\]  (The running kernel .* does not match|",
              "Kernel headers not found at|linux-headers=.* not on mirror)"],
    "source": "installer",
    "reason": "live-ISO ZFS DKMS fallback: ISO kernel newer than archzfs" },
  { "regex": ["^\\[WARN\\]  (ALL DATA ON .* (WILL BE|WILL BE PERMANENTLY) ",
              "DESTROYED|If ZFS pools fail to import on first boot)"],
    "source": "installer", "reason": "the installer's own operator notices" },
  { "regex": "^\\[WARN\\]  Swap auto .* capped to .* on this small disk",
    "source": "installer", "reason": "small audit VM disk (by design)" },
  { "regex": "^Warning: volblocksize \\([0-9]+\\) is less than the default",
    "source": "installer",
    "reason": "ZFS swap zvol uses the page-size block (OpenZFS docs)" },
  { "regex": ["^perl: warning: (Setting locale failed|",
              "Please check that your locale settings|",
              "Falling back to the standard locale)"],
    "source": "installer",
    "reason": "chroot pacman hook (perl) runs before locale-gen" },
  { "regex": "^WARNING: Clamd was NOT notified", "source": "installer",
    "reason": "freshclam in the chroot: clamd is not running there" },
  { "regex": ["^(npm warn |This warning is for project developers|",
              "WARNING: Deprecated features used|",
              "warning: redirecting to https://)"],
    "source": "installer", "reason": "upstream build tool chatter" },
  { "regex": "^warning: archlinux-keyring-.* is up to date -- reinstalling",
    "source": "installer",
    "reason": "keyring refresh before pacstrap (by design)" },
  { "regex": "^aur-vet: .*: PASS \\(0 critical", "source": "installer",
    "reason": "AUR Vetting's own pass summary (ADR 0143): counts, no errors" },
  { "regex": ["^(CMake Warning|config\\.status: WARNING|",
              "configure\\.ac:[0-9]+: warning|.*meson\\.build:[0-9]+: WARNING|",
              "\\.\\./.*: warning: |[a-z_]+\\.c:[0-9]+:[0-9]+: warning: |",
              "Warning: The directory$|",
              "libfakeroot internal error: payload not recognized)"],
    "source": "installer",
    "reason": "AUR package builds' own toolchain output" },
  { "regex": ["^(==> ERROR: Invalid option -k -- '/boot/vmlinuz-linux'|",
              "grep: warning: stray \\\\ before|",
              "egrep: warning: egrep is obsolescent)"],
    "source": "installer",
    "reason": "live-ISO mkinitcpio hook; rkhunter --update's own scripts" },

  // ── VM-only kernel / hardware lines ──
  { "regex": ["^kernel: (x86 CPU feature dependency check failure|",
              "ACPI: IRQ [0-9]+ override|amd_pstate: the _CPC object|",
              "ata[0-9.]+: Model 'QEMU HARDDISK'|",
              "shpchp .*(pci_hp_register failed|Slot initialization failed)|",
              "ata[0-9.]+: Check power mode failed|",
              "xhci_hcd .*: xHC error in resume)"],
    "reason": "QEMU virtual hardware" },
  { "regex": ["^kernel: (spl: loading out-of-tree module taints kernel|",
              "zfs: module license|",
              "Disabling lock debugging due to kernel taint|",
              "rust_binder: Loaded Rust Binder|kauditd_printk_skb|",
              "show_signal_msg: [0-9]+ callbacks suppressed)"],
    "reason": "kernel notices: out-of-tree ZFS taint, rate-limit summaries" },
  { "regex": "^kernel: overlayfs: .*does not support file handles",
    "reason": "rootless podman storage on ZFS: overlayfs uses index=off" },
  { "regex": "^kernel: \\[UFW (BLOCK|LIMIT BLOCK)\\]", "variants": ["ufw"],
    "reason": "ufw logging blocked or rate-limited packets (by design)" },
  { "regex": ["^kernel: (INFO: task .* blocked|      Tainted:|",
              "\"echo 0 > /proc/sys/kernel/hung_task_timeout_secs\"|",
              "\\[drm:virtio_gpu_init)"],
    "phase": "power",
    "reason": "QEMU virtio-gpu after S3 resume (the power phase runs last)" },
  { "regex": ["^(\\[ *[0-9.]+\\] )?\\(sd-(umoun|remou)\\[[0-9]+\\]: ",
              "Failed to (unmount|remount) '?/run/shutdown/mounts/"],
    "reason": "ZFS datasets busy at final shutdown; shutdown proceeds" },
  { "regex": "^\\[ *[0-9.]+\\] net enp[0-9]+s[0-9]+: Unexpected TXQ",
    "reason": "virtio-net driver notice" },
  { "regex": ["^udisksd\\[[0-9]+\\]: Error performing housekeeping for ",
              "drive .*QEMU_HARDDISK.*SMART"],
    "reason": "QEMU disks report no SMART data via udisks" },
  { "regex": "^\\(udev-worker\\)\\[[0-9]+\\]: sr[0-9]: Process '/usr/sbin/pkt",
    "reason": "udftools packet-writing rule on the VM's virtual CD drives" },
  { "regex": ["^(backlighthelper\\[[0-9]+\\]: no kernel backlight interface|",
              "org_kde_powerdevil\\[[0-9]+\\]: org\\.kde\\.powerdevil\\.",
              "(backlighthelper|chargethresholdhelper))"],
    "reason": "no backlight / battery in a VM" },
  { "regex": ["^libvirtd\\[[0-9]+\\]: (internal error: Missing udev ",
              "property|Cannot find 'dmidecode')"],
    "reason": "libvirtd probing QEMU's virtual USB/DMI" },

  // ── docker under firewalld ──
  { "regex": ["^firewalld\\[[0-9]+\\]: WARNING: COMMAND_FAILED: ",
              "'/usr/bin/ip6?tables -w10 -t (nat|filter) -[DFX] .*' failed"],
    "reason": "docker drops stale chains via firewalld; none on fresh boot" },

  // ── systemd / session plumbing ──
  { "regex": ["^systemd-tmpfiles\\[[0-9]+\\]: Opening file ",
              "\"/tmp/\\.X11-unix/X[0-9]+_?\" failed, proceeding without lock"],
    "reason": "tmpfiles locking X sockets (upstream, harmless)" },
  { "regex": ["^systemd-creds\\[[0-9]+\\]: Credential secret file .* ",
              "is not located on encrypted media"],
    "reason": "ZFS native encryption is not detected as encrypted media" },
  { "regex": ["^systemctl\\[[0-9]+\\]: Failed to enqueue jobs: Unit ",
              "systemd-ask-password-plymouth\\.path not loaded"],
    "reason": "no plymouth installed; a stock unit asks for it" },
  { "regex": ["^(dbus-broker-launch\\[[0-9]+\\]: (Activation request for ",
              "'org\\.(freedesktop\\.(home1|ModemManager1|Avahi)|bluez)' ",
              "failed|Service file .* is not named after the D-Bus name|",
              "Ignoring duplicate name)|dbus-broker\\[[0-9]+\\]: ",
              "A security policy denied .*BecomeMonitor)"],
    "reason": "optional D-Bus peers absent; KDE service-file naming" },
  { "regex": ["^(sshd-session|sudo)\\[[0-9]+\\]: pam_systemd(_home)?",
              "\\(.*\\): Failed to (query|get) user record"],
    "reason": "pam_systemd_home queried without homed running" },
  { "regex": ["^accounts-daemon\\[[0-9]+\\]: (Unable to open /etc/tcb|",
              "couldn't list homed users)"],
    "reason": "accountsservice probing optional tcb/homed" },
  { "regex": "^systemd-logind\\[[0-9]+\\]: Failed to abandon session scope",
    "reason": "harness session switches tear sessions down fast" },
  { "regex": ["^systemd\\[[0-9]+\\]: sys-devices-.*-sound-card[0-9]+-",
              "controlC[0-9]+\\.device: Failed to enqueue SYSTEMD_USER_WANTS"],
    "reason": "sound card hotplug before the user manager is up" },
  { "regex": ["^avahi-daemon\\[[0-9]+\\]: (WARNING: No NSS support for ",
              "mDNS|\\*\\*\\* WARNING: Detected another IPv[46] mDNS stack|",
              "Missed message)"],
    "reason": "avahi's own startup warnings, whatever socket-activates it" },

  // ── harness artefacts ──
  { "regex": ["^pkexec\\[[0-9]+\\]: .*Not authorized ",
              ".*COMMAND=/usr/lib/gamemode/"],
    "reason": "gamemode probe over SSH: polkit allows the active seat only" },
  { "regex": ["^kscreenlocker_greet\\[[0-9]+\\]: pam_unix\\(kde:auth\\): ",
              "(auth could not identify password|conversation failed|",
              "unexpected response)"],
    "reason": "lock bind test unlocks via loginctl, not the greeter" },
  { "regex": ["^(drkonqi-coredump-(launcher|processor)\\[[0-9]+\\]|",
              "drkonqi\\[[0-9]+\\]|systemd\\[[0-9]+\\]: ",
              "(drkonqi-coredump-processor@|Dependency failed for Launch ",
              "DrKonqi))"],
    "reason": "DrKonqi bookkeeping; the crash itself is in coredumps" },
  { "regex": "^drkonqi-coredump-processor@.*loaded failed failed",
    "source": "failed-units-system",
    "reason": "DrKonqi times out on a headless crash (crash in coredumps)" },
  { "regex": "^krusader\\[[0-9]+\\]: ", "phase": "keybinds-kde",
    "reason": "Krusader's Qt/KDE chatter; the Meta+K scene launches it" },

  // ── KDE Plasma / Qt upstream chatter ──
  { "regex": ["^[a-zA-Z0-9_.-]+\\[[0-9]+\\]: Failed to register with host ",
              "portal QDBusError"],
    "reason": "KDE apps registering an app ID with the portal (upstream)" },
  { "regex": ["^[a-zA-Z0-9_.-]+\\[[0-9]+\\]: (Connecting to deprecated ",
              "signal|QDBusConnection: name '.*' had owner|",
              "Member .* overrides a member of the base object|",
              "Final member .* is overridden|",
              "QObject::(connect|installEventFilter)|",
              "endResetModel called on|",
              "Trying to use rootObject before initialization)"],
    "reason": "Qt/KF6 developer warnings" },
  { "regex": "^(akonadi_[a-z_]+|akonadiserver|kalendarac)\\[[0-9]+\\]: ",
    "reason": "Akonadi/PIM agents' first-run chatter (no accounts)" },
  { "regex": ["^(plasmashell|kded6|kwin_wayland|org_kde_powerdevil|",
              "kdeconnectd|systemsettings|plasma-welcome|",
              "plasma6\\.0-remove-old-shortcuts|kconf_update|ksmserver|",
              "kaccess|kactivitymanagerd|xembedsniproxy|gmenudbusmenuproxy|",
              "baloo_file|dolphin|kwalletd6|DiscoverNotifier|",
              "xdg-desktop-portal-kde|polkit-kde-authentication-agent-1|",
              "sddm-greeter-qt6|nm-applet)\\[[0-9]+\\]: (",
              "qrc:|file:///|Activity added twice|Could not delete|",
              "SwitcherBackend|requesting unexisting screen|",
              "\"QLocalSocket: Remote closed\"|",
              "\"The shared library was not found\\.\"|",
              "[0-9]+ instead of [0-9]+ arguments|At least one marker level|",
              "Failed (enumerating MM objects|to connect to Bolt)|",
              "Unable to register service to systemBus: ",
              "\"com\\.redhat\\.NewPrinterNotification\"|PendingCall Error|",
              "Cannot find a compatible running Bluez|",
              "Could not query capabilities from notifications server|",
              "Unknown class|Error reading label|Watching for DPMS|",
              "\\[ *[0-9]+\\]|This plugin does not support|",
              "Previously registered enum|Possible conflicting items|",
              "    KWin\\.|\"(clear history|next activity|previous activity|",
              "Slideshow Wallpaper Next Image)\"|/usr/share/kconf_update/|",
              "couldn't load .*DiscoverPackageKitNotifier|",
              "gtk_widget_get_scale_factor|",
              "Unable to connect to the Notification Watcher|",
              "Detected locale \"C\")"],
    "reason": "Plasma chatter: absent optional services, QML deprecations" },
  { "regex": "^sddm\\[[0-9]+\\]: Could not setup default cursor",
    "reason": "SDDM's X greeter cursor theme lookup (upstream)" },
  { "regex": "^plasma-discover\\[[0-9]+\\]: ", "variants": ["kde-pure"],
    "reason": "stock Discover has no Arch backend (wiki: no PackageKit)" },
  { "regex": ["^systemd(-coredump)?\\[[0-9]+\\]: (app-org\\.kde\\.discover@|",
              "Process [0-9]+ \\(plasma-discover\\))"],
    "variants": ["kde-pure"],
    "reason": "stock Plasma's backend-less Discover aborting" },
  { "regex": "/usr/bin/plasma-discover",
    "source": "coredumps", "variants": ["kde-pure"],
    "reason": "stock Plasma's backend-less Discover aborting" },

  // ── PipeWire / portals ──
  { "regex": ["^(wireplumber|pipewire|pipewire-pulse|wpctl)\\[[0-9]+\\]: ",
              "(spa\\.bluez5: BlueZ system service is not available|",
              "default: Failed to get percentage from UPower)"],
    "reason": "no Bluetooth adapter / battery in a VM" },
  { "regex": ["^/usr/lib/xdg-desktop-portal\\[[0-9]+\\]: Choosing ",
              "gtk\\.portal for org\\.freedesktop\\.impl\\.portal\\.Lockdown"],
    "reason": "portal backend fallback choice (upstream, warning level)" },
  { "regex": ["^xdg-desktop-portal-gnome\\[[0-9]+\\]: Using GtkSettings:",
              "gtk-application-prefer-dark-theme with libadwaita"],
    "reason": "libadwaita deprecation notice (upstream)" },
  { "regex": "/usr/lib/xdg-desktop-portal-hyprland",
    "source": "coredumps",
    "reason": "xdph segfaults in exit() as Hyprland ends (upstream)" },

  // ── compositor startup logs (stdout at ERR level) ──
  { "regex": ["^(DEBUG \\]: Creating the Error Overlay!|ERR from aquamarine ",
              "\\]: (Wayland backend cannot start|Requested backend ",
              "\\(wayland\\) could not start|Implementation wayland failed|",
              "\\[EGL\\] Command eglQueryDevicesEXT))"],
    "source": "hyprland",
    "reason": "Hyprland probing backends before it settles on DRM (VM)" },
  { "regex": ["^WARN \\]: (Creating config home directory|",
              "No config file found; attempting to generate)"],
    "source": "hyprland", "variants": ["hyprland-pure", "no-shell"],
    "reason": "bare Hyprland ships no config; it writes one (ADR 0112)" },
  { "regex": ["^(> Warning: +(Multiple symbols for level|",
              "Symbol map for key|Could not resolve keysym XF86|",
              "Unsupported maximum keycode|",
              "Virtual modifier .* multiply defined)|",
              "Errors from xkbcomp are not fatal|xcb_connect\\(\\) failed)"],
    "source": "wayland-session",
    "reason": "Xwayland xkbcomp: keysyms newer than xkeyboard-config" },
  // ── serial console at shutdown (approved 2026-10-04) ──
  { "regex": "\\[FAILED\\] Failed unmounting /(etc|var|var/log)\\.$",
    "source": "serial",
    "reason": "busy ZFS impermanence datasets; systemd-shutdown ends them" },
  { "regex": "ata[0-9]+\\.00: Check power mode failed \\(err_mask=",
    "source": "serial",
    "reason": "QEMU AHCI disks answer no CHECK POWER MODE at shutdown" },
  { "regex": ["\\[drm:virtio_gpu_cmd_get_capset_info_cb \\[virtio_gpu\\]\\] ",
              "\\*ERROR\\* invalid capset memory"],
    "source": "serial", "reason": "QEMU virgl capset query at shutdown" },
  // ── no Wayland shell, no notification daemon ──
  { "regex": ["dbus-:[0-9.]+-org\\.freedesktop\\.Notifications@[0-9]+",
              "\\.service: Failed with result"],
    "variants": ["no-shell"],
    "reason": "Plasma Notifications activated outside Plasma: no daemon" },
  // ── approved 2026-10-04 (2) ──
  { "regex": ["searx\\.botdetection: X-Forwarded-For nor X-Real-IP ",
              "header is set!$"],
    "reason": "upstream logs it once for direct (no proxy) private access" },
  { "regex": ["cc_resizefs\\.py\\[WARNING\\]: Device '/dev/airootfs' ",
              "did not exist"],
    "source": "installer", "variants": ["guided"],
    "reason": "the live ISO's own cloud-init, before our installer runs" },
  // ── approved 2026-10-04 (3): the VM's virgl GPU stalling ──
  { "regex": ["kernel: INFO: task .* blocked for more than [0-9]+ seconds",
              "\\..* \\| .*virtio_gpu"],
    "source": "journal",
    "reason": "host virgl stall (folded report, stack in virtio_gpu)" },
  // ── approved 2026-10-04 (4) ──
  { "regex": ["^ *- curl error [0-9]+ while downloading ",
              "https://repo\\.packagist\\.org/"],
    "source": "installer",
    "reason": "composer's own retried fetch in an AUR build that succeeded" },
  // ── approved 2026-10-05 ──
  { "regex": "^Installation finished\\. No error reported\\.$",
    "source": "installer", "reason": "grub-install's own success line" },
  { "regex": "^╭ Warning ─+╮$", "source": "installer",
    "reason": "pnpm's advisory box inside an AUR build (basedpyright)" },
  { "regex": ["NetworkManager\\[[0-9]+\\]: <warn> .* ",
              "device \\(veth[0-9a-f]+\\)",
              ": connectivity: .*rp_filter.* is set to \"1\""],
    "reason": "podman veth interfaces; NM's connectivity hint only" },
  { "regex": ["(systemd-searxng|searxng)\\[[0-9]+\\]: |searxng\\.service|",
              "SearXNG metasearch engine|",
              "podman-user-wait-network-online|",
              "aardvark-dns\\[[0-9]+\\]: .*Network is unreachable"],
    "phase": "probes-offline",
    "reason": "a metasearch engine with the network cut on purpose" },
  // ── approved 2026-10-05 (2) ──
  { "regex": ["xwayland-satell(ite)?\\[[0-9]+\\]: .*No last focused toplevel, ",
              "cannot focus window"],
    "reason": "xwayland-satellite focus chatter; the X11 app itself runs" },
  // ── approved 2026-10-06 ──
  { "regex": ["\\[WARN\\] +Plugin [^ ]+ fetch failed \\(offline\\?\\) ",
              "— skipped\\.$"],
    "source": "installer",
    "reason": "a network outage through all 3 plugin fetch retries" },
  { "regex": ["kdeconnectd\\[[0-9]+\\]: Failed to send mDNS query: ",
              "Cannot assign requested address"],
    "reason": "kdeconnectd mDNS probe on the VM's network" },
  // ── approved 2026-10-07 ──
  { "regex": ["pkgfile-update\\.service|",
              "Failed to start pkgfile database update"],
    "phase": "probes-offline",
    "reason": "its daily timer fired while the network was cut on purpose" },
  // ── approved 2026-10-08 ──
  { "regex": ["SIGABRT present /usr/bin/zfs |",
              "systemd-coredump\\[[0-9]+\\]: Process [0-9]+ \\(zfs\\) ",
              "of user 0 dumped core\\.|",
              "zfs-mount\\.service: (Main process exited, code=dumped, ",
              "status=6/ABRT|Failed with result 'core-dump')|",
              "Failed to start Mount ZFS filesystems\\."],
    "reason": "libzfs mount abort (upstream); retried: a failed unit is kept" },
  { "regex": ["systemd-searxng\\[[0-9]+\\]: .*",
              "https://cdn\\.jsdelivr\\.net/gh/clearurls/"],
    "reason": "SearXNG upstream tracker-pattern URL 404s; it still runs" }
]
