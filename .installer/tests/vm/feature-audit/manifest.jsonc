// Audit Manifest (ADR 0152): the Feature Audit's max-feature base and the
// Audit Variants that reach what the base cannot. Variant kinds:
//   { "id" }                   the base itself
//   { "id", "patch": {...} }   base host profile deep-merged with the patch
//   { "id", "host": "<h>" }    a real host as-is ("hardware" required)
//   { "id", "guided": "<p>" }  a guided install (tests/vm/profiles ref)
// "adrs" lists the ADRs a variant exists to cover. "phases" are its Variant
// Phases (absent = all; install + boot1 always run). "unverifiable" marks what
// no VM can prove (feature or program:<name>) — each needs a reason and
// maintainer review.
//
// Real hosts: desktop and laptop install as-is; `core` is Host Core, a
// reserved layer every host merges over (never loadable alone), so every
// variant covers it. The guided variant runs the disposable guided test flow
// (install + boot-verify only: not agent-controllable, so no later phases).
// Variants beyond the bootloader/firewall/pure/real-host set exist because
// the feature-coverage check derives every menu value that needs a VM.
{
  "vm_name": "arch-audit",
  "base": {
    "host": "arch-audit",
    "hardware": { "disks": [60, 60, 20], "ram_mb": 10240, "vcpus": 8 },
    "fixtures": ["fixtures/key.age"]
  },
  "variants": [
    { "id": "base", "adrs": ["0036", "0046", "0104", "0117", "0152"] },
    { "id": "grub", "patch": { "options": { "bootloader": "grub" } },
      "phases": ["boot2", "upgrade"],
      "adrs": ["0038", "0078"] },
    { "id": "limine", "patch": { "options": { "bootloader": "limine" } },
      "phases": ["boot2", "upgrade"],
      "adrs": ["0078"] },
    { "id": "refind", "patch": { "options": { "bootloader": "refind" } },
      "phases": ["boot2", "upgrade"],
      "adrs": ["0078"] },
    { "id": "efistub", "patch": { "options": { "bootloader": "efistub" } },
      "phases": ["boot2", "upgrade"],
      "adrs": ["0078"] },
    { "id": "kernels",
      "patch": {
        "options": { "kernel": ["lts", "default", "hardened", "zen"] }
      },
      "phases": ["boot2", "upgrade"],
      "adrs": ["0137", "0138", "0139"] },
    { "id": "ufw",
      "patch": { "post_install": { "security": { "firewall": "ufw" } } },
      "phases": ["probes", "timers", "boot2"],
      "adrs": ["0115"] },
    // independent choices sharing one install: the non-default power daemon
    // and an explicit (not auto-resolved) sddm
    { "id": "tuned",
      "patch": {
        "options": { "power": { "profile": "tuned" } },
        "environment": { "display_manager": "sddm" }
      },
      "phases": ["sessions", "probes", "timers", "power"],
      "adrs": ["0069", "0080", "0091"] },
    { "id": "greetd",
      "patch": { "environment": { "display_manager": "greetd" } },
      "phases": ["sessions", "keybinds", "boot2"],
      "adrs": ["0069", "0091"] },
    { "id": "no-shell",
      "patch": { "environment": { "wayland_shell": "none" } },
      "phases": ["sessions", "probes", "keybinds"],
      "adrs": ["0090", "0097"] },
    // every service toggle off: the "not installed" side must be clean too
    { "id": "services-off",
      "patch": {
        "options": {
          "printing": { "enabled": false }, "bluetooth": { "enabled": false },
          "power": { "profile": "none" }
        },
        "post_install": {
          "security": { "firewall": "none", "antivirus": false,
                        "rootkit": false, "apparmor": false },
          "backup": { "zfs_auto_snapshot": false, "borg": false }
        }
      },
      "phases": ["probes", "timers", "boot2", "power"],
      "adrs": ["0041", "0079", "0080"] },
    { "id": "kde-pure", "host": "kde-pure",
      "hardware": { "disks": [60], "ram_mb": 8192, "vcpus": 4 },
      "adrs": ["0112"] },
    { "id": "niri-pure", "host": "niri-pure",
      "hardware": { "disks": [60], "ram_mb": 8192, "vcpus": 4 },
      "adrs": ["0112"] },
    { "id": "hyprland-pure", "host": "hyprland-pure",
      "hardware": { "disks": [60], "ram_mb": 8192, "vcpus": 4 },
      "adrs": ["0112"] },
    { "id": "minimal", "host": "minimal",
      "hardware": { "disks": [40], "ram_mb": 4096, "vcpus": 4 },
      "adrs": ["0034"] },
    { "id": "desktop", "host": "desktop",
      "hardware": { "disks": [60, 60, 20, 20, 20], "ram_mb": 10240,
                    "vcpus": 8 },
      "adrs": ["0036", "0114"] },
    { "id": "laptop", "host": "laptop",
      "hardware": { "disks": [80], "ram_mb": 10240, "vcpus": 8 },
      "adrs": ["0036", "0114"] },
    // the menu-driven path; manual partitioning is guided-only (ADR 0073)
    { "id": "guided", "guided": "single/guided-manual",
      "covers": ["disk_config.kind=manual"],
      "adrs": ["0039", "0073"] }
  ],
  "unverifiable": [
    // menu values no VM can hold
    { "feature": "environment.gpu=amd",
      "reason": "no AMD GPU in libvirt; virtio-gpu only" },
    { "feature": "environment.gpu=nvidia",
      "reason": "no NVIDIA GPU in libvirt; virtio-gpu only" },
    { "feature": "environment.gpu=intel",
      "reason": "no Intel GPU in libvirt; virtio-gpu only" },
    // hardware-bound parts of probed programs (the rest of each is probed)
    { "feature": "hw:bluetooth-adapter",
      "reason": "no Bluetooth controller in libvirt; bluez wiring probed" },
    { "feature": "hw:lact-gpu-tuning",
      "reason": "no AMD/NVIDIA GPU; lactd start probed" },
    { "feature": "hw:fwupd-update",
      "reason": "no updatable firmware devices; device list + refresh probed" },
    { "feature": "hw:laptop-battery-lid",
      "reason": "QEMU has no battery or lid switch; power daemon probed" },
    { "feature": "hw:smartd-daemon",
      "reason": "smartd skips VMs (ConditionVirtualization=no); SMART probed" },
    { "feature": "hw:teamspeak3-connect",
      "reason": "needs a TeamSpeak server; client launch probed" },
    { "feature": "hw:media-brightness-keys",
      "reason": "no backlight or MPRIS player; those keybinds are SKIPs" },
    { "feature": "hw:multi-monitor",
      "reason": "one virtual monitor; monitor-focus/move keybinds are SKIPs" },
    { "feature": "hw:secure-boot-tpm",
      "reason": "the installer ships no Secure Boot signing or TPM enrolment" }
  ]
}
