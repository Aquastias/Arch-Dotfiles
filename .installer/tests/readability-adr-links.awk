# readability-adr-links.awk — Linked ADRs rule of the Readability Lint
# (ADR 0153), driven by readability.sh.
#
# Every `ADR NNNN` mention in a doc is a Markdown shortcut reference link —
# `[ADR 0058]` — resolved by a definition block at the end of the file. The
# shortcut form adds two characters per mention, so lines keep their width.
# Fenced code, inline code, and an ADR's mentions of itself are skipped.
#
# Variables:
#   mode       "check" — print TSV violations (rule, file, line, symbol,
#                        detail); "fix" — print the file with every mention
#                        linked and the definition block regenerated.
#   adr_index  newline-separated ADR file names (`0058-some-slug.md`).

BEGIN {
  MARKER = "<!-- ADR links: generated by readability.sh --fix-adr-links -->"
  MENTION = "ADR[ -]?[0-9][0-9][0-9][0-9]"
  MAX_WIDTH = 80
  count = split(adr_index, names, "\n")
  for (n = 1; n <= count; n++)
    if (names[n] != "") adr_file[substr(names[n], 1, 4)] = names[n]
}

function adr_number(label) {
  return substr(label, length(label) - 3)
}

# relative_prefix(path) — "../" once per directory level of path.
function relative_prefix(path,   prefix, levels, n) {
  prefix = ""
  levels = gsub(/\//, "/", path)
  for (n = 0; n < levels; n++) prefix = prefix "../"
  return prefix
}

function own_number(path) {
  if (path ~ /^docs\/adr\/[0-9][0-9][0-9][0-9]-/) return substr(path, 10, 4)
  return ""
}

function report(line, label, detail) {
  printf "adr-link\t%s\t%d\t%s\t%s\n", current_file, line, label, detail
}

# link_mentions(text, line) — returns text with unlinked mentions bracketed
# (fix) or reports them (check). Records every label used.
function link_mentions(text, line,   out, label, before, after, number) {
  out = ""
  while (match(text, MENTION)) {
    label = substr(text, RSTART, RLENGTH)
    after = substr(text, RSTART + RLENGTH, 1)
    number = adr_number(label)
    out = out substr(text, 1, RSTART - 1)
    before = substr(out, length(out), 1)
    text = substr(text, RSTART + RLENGTH)
    if (number == own_number(current_file) || !(number in adr_file)) {
      out = out label
      continue
    }
    if (before == "[" && after == "]") {
      if (substr(text, 2, 1) != "(") record_linked(label, line)
      out = out label "]"
      text = substr(text, 2)
    } else {
      used[label] = 1
      if (mode == "check") report(line, label, label " is not a link")
      # `[ADR 0058]:` at a line start would read as a link definition; the
      # collapsed form `[ADR 0058][]` renders the same and cannot.
      if (out ~ /^[ \t]*$/ && substr(text, 1, 1) == ":")
        out = out "[" label "][]"
      else
        out = out "[" label "]"
    }
    # A chained number — `ADR 0040/0043` — links each number after the slash.
    while (match(text, /^\/\[?[0-9][0-9][0-9][0-9]\]?/)) {
      number = substr(text, RLENGTH >= 7 ? 3 : 2, 4)
      if (!(number in adr_file)) break
      if (RLENGTH == 7) record_linked(number, line)
      else {
        if (RLENGTH != 5) break
        used[number] = 1
        if (mode == "check") report(line, number, number " is not a link")
      }
      out = out "/[" number "]"
      text = substr(text, RLENGTH + 1)
    }
  }
  return out text
}

function record_linked(label, line) {
  used[label] = 1
  if (!(label in first_use)) first_use[label] = line
}

FNR == 1 {
  if (NR > 1) finish_file()
  current_file = FILENAME
  in_fence = 0
  in_block = 0
  line_count = 0
  split("", used)
  split("", first_use)
  split("", defined)
}

{
  raw = $0
  if (raw == MARKER) { in_block = 1; next }
  if (match(raw, "^\\[(" MENTION "|[0-9][0-9][0-9][0-9])\\]:")) {
    defined[substr(raw, 2, RLENGTH - 3)] = 1
    if (in_block) next
  }
  if (in_block && raw == "") next
  in_block = 0

  if (raw ~ /^[ \t]*(```|~~~)/) in_fence = !in_fence
  if (in_fence || raw ~ /^[ \t]*(```|~~~)/) {
    lines[++line_count] = raw
    changed[line_count] = 0
    next
  }
  # Even-numbered backtick pieces are inline code: leave them as written.
  pieces = split(raw, piece, "`")
  rebuilt = ""
  for (n = 1; n <= pieces; n++) {
    if (n % 2 == 1) piece[n] = link_mentions(piece[n], FNR)
    rebuilt = rebuilt (n > 1 ? "`" : "") piece[n]
  }
  lines[++line_count] = rebuilt
  changed[line_count] = (rebuilt != raw)
}

function finish_file(   n, label, prefix, sorted, total) {
  if (mode == "check") {
    for (label in first_use)
      if (!(label in defined))
        report(first_use[label], label, "[" label "] has no definition")
    return
  }
  # Trailing blank lines go; the definition block follows one blank line.
  while (line_count > 0 && lines[line_count] == "") line_count--
  rewrap_changed_lines()
  for (n = 1; n <= line_count; n++) print lines[n]
  total = 0
  for (label in used) sorted[++total] = label
  if (!total) return
  sort_labels(sorted, total)
  prefix = relative_prefix(current_file) "docs/adr/"
  if (current_file ~ /^docs\/adr\/[^\/]+$/) prefix = ""
  print ""
  print MARKER
  for (n = 1; n <= total; n++)
    printf "[%s]: %s%s\n", sorted[n], prefix, \
      adr_file[adr_number(sorted[n])]
}

# starts_block(text) — text at a line start would become a list item,
# heading, or blockquote, so a wrap must not leave it there.
function starts_block(text) {
  return text ~ /^([-*+>]|#+|[0-9]+[.)])([ \t]|$)/ || text ~ /^\[[^]]*\]:/
}

# leading_text(line) — the indent a wrapped continuation of line keeps:
# its whitespace, plus a list marker's width or a blockquote's `> `.
function leading_text(line,   prefix) {
  if (match(line, /^[ \t]*([-*+]|[0-9]+\.)[ \t]+/)) {
    prefix = substr(line, 1, RLENGTH)
    gsub(/[^ \t]/, " ", prefix)
    return prefix
  }
  match(line, /^[ \t]*(>[ \t]?)*/)
  return substr(line, 1, RLENGTH)
}

# continues_paragraph(line) — line is prose that wrapped text may join.
function continues_paragraph(line) {
  return line !~ /^[ \t]*$/ && line !~ /^[ \t]*([-*+]|[0-9]+\.)[ \t]/ \
    && line !~ /^[ \t]*(#|\||```|~~~|<!--)/ \
    && line !~ /^\[[^]]*\]:/
}

# rewrap_changed_lines() — linking adds two characters per mention; a
# changed line pushed past MAX_WIDTH carries its overflow words into the
# paragraph's next line (or a new one). Untouched lines keep their wrap.
function rewrap_changed_lines(   n, line, indent, cut, overflow, m,
                                 next_indent) {
  for (n = 1; n <= line_count; n++) {
    line = lines[n]
    if (!changed[n] || length(line) <= MAX_WIDTH) continue
    if (line ~ /^[ \t]*(#|\|)/) continue
    indent = leading_text(line)
    for (cut = MAX_WIDTH + 1; cut > length(indent) + 1; cut--)
      if (substr(line, cut, 1) == " " && substr(line, cut - 3, 3) != "ADR" \
          && !starts_block(substr(line, cut + 1)))
        break
    if (cut <= length(indent) + 1) continue
    overflow = substr(line, cut + 1)
    lines[n] = substr(line, 1, cut - 1)
    if (n < line_count && continues_paragraph(lines[n + 1])) {
      match(lines[n + 1], /^[ \t]*/)
      next_indent = substr(lines[n + 1], 1, RLENGTH)
      lines[n + 1] = next_indent overflow " " \
                     substr(lines[n + 1], RLENGTH + 1)
    } else {
      for (m = line_count; m > n; m--) {
        lines[m + 1] = lines[m]
        changed[m + 1] = changed[m]
      }
      line_count++
      lines[n + 1] = indent overflow
    }
    changed[n + 1] = 1
  }
}

function sort_labels(list, total,   i, j, held) {
  for (i = 2; i <= total; i++) {
    held = list[i]
    for (j = i - 1; j >= 1 && list[j] > held; j--) list[j + 1] = list[j]
    list[j + 1] = held
  }
}

END { if (NR > 0) finish_file() }
