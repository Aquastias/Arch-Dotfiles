// Program metadata for apparmor.
//
// kind=user → installed by the profile runner inside the chroot as the
// owning user via paru, with temp NOPASSWD sudo for /etc/default/grub edits
// and grub-mkconfig. Patches kernel params; effective after reboot.

{
  "name": "apparmor",
  "kind": "user",
  "description": "AppArmor MAC with required GRUB kernel parameters."
}
