// Program metadata for vscodium.
//
// kind=user → installed by the profile runner inside the chroot as the owning
// user via paru (vscodium-bin is AUR). The opt-in parity twin of the Neovim
// Config (ADR 0148); install.sh adds the package + extensions, Config Apply
// places home/ (ADR 0134).

{
  "name": "vscodium",
  "kind": "user",
  "description": "VSCodium with nvim-parity extensions, settings and keymaps.",
  "stow_opt_in": true
}
