// Program metadata for grub.
//
// kind=host → installed by the profile runner with pacman during the
// chroot phase. Referenced by name only from host configs. The bootloader
// adapter (options.bootloader=grub) installs and configures GRUB on the ESP;
// this program only ensures the package. No os-prober: the rendered grub.cfg
// has no grub-mkconfig pass to run it (ADR 0078).
{
  "name": "grub",
  "kind": "host",
  "description": "GRUB bootloader (configured by the grub bootloader adapter)."
}
