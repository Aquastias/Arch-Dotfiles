// niri glue for the Noctalia work shell — stow-owned dotfile (ADR 0090/0094),
// skel-seeded by the installer (ADR 0095). Autostarts Noctalia and carries the
// shared niri↔Hyprland keybind vocabulary (ADR 0096) so switching compositors
// feels like home. Noctalia owns its own look (config.toml); edit freely.

// Skip niri's "Important Hotkeys" overlay on startup — no welcome screen on
// first login. Toggle it any time with Mod+Shift+Slash.
hotkey-overlay {
    skip-at-startup
}

// Default cursor: Bibata Modern Ice, the fleet default shared with KDE/Hyprland
// (ADR 0098). niri exports XCURSOR_THEME/XCURSOR_SIZE to spawned apps, so
// GTK/XWayland clients follow it too.
cursor {
    xcursor-theme "Bibata-Modern-Ice"
    xcursor-size 24
}

// Route Qt apps through qt6ct so they follow Noctalia's palette — App Theming
// Bridge (ADR 0102). Set per-compositor (Hyprland uses `env =`), not via
// environment.d, which Hyprland's start-hyprland session can't see (ADR 0070).
environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// Input devices (ADR 0100). Touchpad tap-to-click + natural scroll +
// disable-while-typing make a fresh laptop feel right out of the box; keyboard
// layout/repeat match a standard US board. No `output` block on purpose —
// display scale/mode is host-specific and kept out of the portable curated
// config (ADR 0094), same reason config.toml excludes host-bound state.
input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 600
        repeat-rate 25
    }
    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
        accel-profile "adaptive"
    }
}

// Minimal layout (ADR 0100): gaps + a sensible column-width cycle (Mod+R walks
// these). Colors stay Noctalia's to own via its config.toml theme templates, so
// no focus-ring/border colors are hardcoded here.
layout {
    gaps 16
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
}

// Window rules (ADR 0100): rounded corners on every window — the niri parallel
// to Hyprland's decoration rounding, so both compositors read the same.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

spawn-at-startup "noctalia" "--daemon"
// First-login one-shot: enable the vendored plugins once (ADR 0093). Self-
// guards, so it is a no-op on every later login — safe to leave in place.
spawn-at-startup "sh" "-c" "$HOME/.local/bin/noctalia-enable-plugins"

binds {
    // ── Shared vocabulary (matches ~/.config/hypr/hyprland.conf, ADR 0096) ──
    // Apps: terminal, close, launcher, quit, lock. Launcher + lock go through
    // Noctalia's IPC (Hyprland spawns wofi / hyprlock on the same keys).
    Mod+Return hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+Q repeat=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+D hotkey-overlay-title="App Launcher" {
        spawn-sh "noctalia msg panel-toggle launcher";
    }
    // File manager: pcmanfm-qt, the shared preset FM (ADR 0100). Matches
    // Hyprland's Super+E so the key means the same on both compositors.
    Mod+E hotkey-overlay-title="File Manager" { spawn "pcmanfm-qt"; }
    Super+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn-sh "noctalia msg session lock";
    }
    Mod+Shift+E hotkey-overlay-title="Quit niri" { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Window state.
    Mod+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+V hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    // Focus. niri splits column (H/L) from window-in-column (J/K); this is the
    // closest mapping to Hyprland's directional focus.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // Move the focused window/column (Mod+Ctrl, mirrors Hyprland's move binds).
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // Workspaces by number 1-9 (no 10 — niri is dynamic, ADR 0096).
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move window to a workspace. Mod+Shift is the shared Hyprland habit;
    // Mod+Ctrl is niri's own default — both kept so either reflex works.
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Screenshots — niri's built-in capture (no extra tooling).
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Volume / brightness / media hardware keys (allow-when-locked so they work
    // on the lock screen). Shared verbatim with Hyprland.
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-";
    }
    XF86AudioMute        allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";
    }
    XF86AudioMicMute     allow-when-locked=true {
        spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";
    }
    XF86MonBrightnessUp   allow-when-locked=true {
        spawn "brightnessctl" "--class=backlight" "set" "5%+";
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn "brightnessctl" "--class=backlight" "set" "5%-";
    }
    XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }

    // ── niri-only power features (on keys Hyprland leaves free, ADR 0096) ──
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+M { maximize-window-to-edges; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+W { toggle-column-tabbed-display; }

    // Build and break columns.
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Directional / dynamic workspace navigation (niri's vertical stack).
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+U         { focus-workspace-down; }
    Mod+I         { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    // Multi-monitor: focus (Mod+Shift), move a column across (add Ctrl).
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }

    // Blank the monitors; wake with any input.
    Mod+Shift+P { power-off-monitors; }

    // Escape hatch: let a buggy remote-desktop/KVM app never hold the session
    // hostage by inhibiting shortcuts.
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
