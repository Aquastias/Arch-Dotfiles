// niri glue for the Noctalia work shell — stow-owned dotfile (ADR 0090/0094),
// skel-seeded by the installer (ADR 0095). Autostarts Noctalia and carries the
// shared niri↔Hyprland keybind vocabulary (ADR 0096) so switching compositors
// feels like home. Noctalia owns its own look (config.toml); edit freely.
//
// This entry file is a pure manifest (ADR 0107): every setting lives in a
// conf.d/ part-file, mirrored one-for-one with ~/.config/hypr/conf.d/. niri
// merges included sections and inserts window-rules positionally, so the order
// below is deliberate. Includes are top-level only — never nest them.
include "conf.d/environment.kdl"
include "conf.d/input.kdl"
include "conf.d/appearance.kdl"
include "conf.d/autostart.kdl"
include "conf.d/keybinds.kdl"
include "conf.d/media.kdl"
include "conf.d/rules.kdl"
