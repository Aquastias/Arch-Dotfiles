#!/bin/sh
# Stow-owned dotfile (ADR 0093/0094): first-login one-shot — enable the vendored
# [local] plugins once (their "export" only runs on an explicit enable). Spawned
# by the compositor beside Noctalia; enables every plugin vendored under the
# data dir, then guards itself so it runs exactly once.
# Never `noctalia msg plugins list`: it runs on Noctalia's main loop and waits
# on the plugin-source lock the startup export worker holds for minutes on a
# fresh install — the shell, and its ScreenSaver/Notifications names, froze
# (portal-gtk hung on them). `enable` returns at once (exports in background).
set -eu
guard="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/installer-plugins-enabled"
[ -f "$guard" ] && exit 0
dir="${XDG_DATA_HOME:-$HOME/.local/share}/noctalia/plugins"
ids="$(sed -nE 's/^[[:space:]]*id[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/p' \
  "$dir"/*/plugin.toml 2>/dev/null)" || true
[ -n "$ids" ] || exit 0
i=0
for id in $ids; do
  # the first enable doubles as the wait for Noctalia's IPC (co-spawned)
  while ! out="$(noctalia msg plugins enable "$id" 2>&1)"; do
    case "$out" in *"not running"*) ;; *) break ;; esac
    i=$((i + 1)); [ "$i" -ge 60 ] && exit 0  # give up this login; retry next
    sleep 1
  done
done
mkdir -p "$(dirname "$guard")"
: > "$guard"
