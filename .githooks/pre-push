#!/usr/bin/env bash
# Opt-in pre-push gate: the curated install-correctness subset (ADR 0078).
# Enable once with:  git config core.hooksPath .githooks
# Skip a single push with:  SKIP_FAST_TESTS=1 git push
set -euo pipefail

[[ -n "${SKIP_FAST_TESTS:-}" ]] && { echo "[pre-push] skipped"; exit 0; }

HERE="$(git rev-parse --show-toplevel)"
exec "$HERE/.installer/tests/run.sh" --fast
