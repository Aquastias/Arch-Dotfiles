# Claude Code: ignore internals/state, track only the stow files (ADR 0133)
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/scripts/
.claude/scripts/*
!.claude/scripts/statusline.sh
# Claude auth is secret — never committed/stowed (ADR 0133, cf. pi ADR 0127)
.claude/.credentials.json

# Neovim
.config/nvim/tt.*
.config/nvim/.tests
.config/nvim/doc/tags
.config/nvim/debug
.config/nvim/.repro
.config/nvim/foo.*
.config/nvim/*.log
.config/nvim/data

# VM test harness — vendored bats, caches, and run logs
.installer/tests/bats/
.installer/**/.vm-test/
.installer/**/.vm-cache/
.installer/testing-vm-logs
.installer/tests/vm/*.log

# Generated per-user stow tree (ADR 0012)
.stow/

# Pi coding agent: OAuth tokens are secret — never committed/stowed (ADR 0127)
.pi/agent/auth.json
# Pi theme file is Noctalia-generated/seed-only — never stowed (ADR 0128/0104)
.pi/agent/themes/
# Zsh theme files are Noctalia-generated/seed-only — never stowed (ADR 0128)
.zsh/themes/
# Kitty theme file is Noctalia-generated/seed-only — never stowed (ADR 0130/0104)
.config/kitty/themes/
